# =========================================================================
# PackageDbEntry
# Fields: name(0) version(8) source(16) installed_at(24) installed_by(32)
#         size_bytes(40) checksum(48) files(56) dependencies(64)
#         transaction_id(72) held(80) file_checksums(88)
#         signature(96) signer_key_id(104)
#         pinned_version(112) pinned_source(120)   => 128 bytes
# =========================================================================

var PDBE_SZ = 128;

fn pdbe_name(p) { return load64(p); }
fn pdbe_version(p) { return load64(p + 8); }
fn pdbe_source(p) { return load64(p + 16); }
fn pdbe_installed_at(p) { return load64(p + 24); }
fn pdbe_set_installed_at(p, v) { store64(p + 24, v); }
fn pdbe_installed_by(p) { return load64(p + 32); }
fn pdbe_set_installed_by(p, v) { store64(p + 32, v); }
fn pdbe_size(p) { return load64(p + 40); }
fn pdbe_set_size(p, v) { store64(p + 40, v); }
fn pdbe_checksum(p) { return load64(p + 48); }
fn pdbe_set_checksum(p, v) { store64(p + 48, v); }
fn pdbe_files(p) { return load64(p + 56); }
fn pdbe_deps(p) { return load64(p + 64); }
fn pdbe_held(p) { return load64(p + 80); }
fn pdbe_set_held(p, v) { store64(p + 80, v); }
fn pdbe_file_checksums(p) { return load64(p + 88); }
fn pdbe_signature(p) { return load64(p + 96); }
fn pdbe_set_signature(p, v) { store64(p + 96, v); }
fn pdbe_signer(p) { return load64(p + 104); }
fn pdbe_set_signer(p, v) { store64(p + 104, v); }
fn pdbe_pinned_ver(p) { return load64(p + 112); }
fn pdbe_set_pinned_ver(p, v) { store64(p + 112, v); }
fn pdbe_pinned_src(p) { return load64(p + 120); }
fn pdbe_set_pinned_src(p, v) { store64(p + 120, v); }

fn db_entry_new(name, version, source) {
    var p = alloc(PDBE_SZ);
    store64(p, name);
    store64(p + 8, version);
    store64(p + 16, source);
    store64(p + 24, ark_now_secs());
    store64(p + 32, str_from("root"));
    store64(p + 40, 0);
    store64(p + 48, str_from(""));
    store64(p + 56, vec_new());
    store64(p + 64, vec_new());
    store64(p + 72, str_from(""));
    store64(p + 80, 0);
    store64(p + 88, map_new());
    store64(p + 96, str_from(""));
    store64(p + 104, str_from(""));
    store64(p + 112, str_from(""));
    store64(p + 120, 0 - 1);
    return p;
}

# =========================================================================
# Per-file checksum management
# =========================================================================

# Record a file's SHA-256 hash in the per-file map
fn pdbe_set_file_hash(entry, file_path, hash) {
    map_set(pdbe_file_checksums(entry), str_data(file_path), hash);
}

# Get a file's expected hash (returns 0 if not found)
fn pdbe_get_file_hash(entry, file_path) {
    return map_get(pdbe_file_checksums(entry), str_data(file_path));
}

# Compute and store hashes for all files in the entry
fn pdbe_compute_file_hashes(entry) {
    sha256_global_init();
    var fls = pdbe_files(entry);
    var i = 0;
    while (i < vec_len(fls)) {
        var fpath = vec_get(fls, i);
        var hash = hash_file(str_data(fpath));
        if (hash > 0) {
            pdbe_set_file_hash(entry, fpath, hash);
        }
        i = i + 1;
    }
}

# =========================================================================
# Package signing via sigil Ed25519
# =========================================================================

# Sign a package entry: hashes all files, signs the concatenated hash,
# stores signature + key_id on the entry.
fn pdbe_sign(entry, secret_key, key_id) {
    ed25519_init();
    sha256_global_init();
    # Compute per-file hashes
    pdbe_compute_file_hashes(entry);
    # Build canonical string to sign: "name:version:hash1:hash2:..."
    var sb = str_builder_new();
    str_builder_add(sb, pdbe_name(entry));
    str_builder_add_cstr(sb, ":");
    str_builder_add(sb, pdbe_version(entry));
    var fls = pdbe_files(entry);
    var i = 0;
    while (i < vec_len(fls)) {
        str_builder_add_cstr(sb, ":");
        var h = pdbe_get_file_hash(entry, vec_get(fls, i));
        if (h > 0) { str_builder_add(sb, h); }
        i = i + 1;
    }
    var msg = str_builder_build(sb);
    # Decode secret key from hex if needed
    var sig = sign_data(str_data(msg), str_len(msg), secret_key);
    var sig_hex = hex_encode(sig, 64);
    pdbe_set_signature(entry, str_from(sig_hex));
    pdbe_set_signer(entry, key_id);
    # Also set the legacy single checksum as the content hash
    var content_hash = hash_data(str_data(msg), str_len(msg));
    pdbe_set_checksum(entry, content_hash);
}

# Verify a package entry's signature against a public key.
# Returns 1 if valid, 0 if invalid or unsigned.
fn pdbe_verify(entry, public_key) {
    ed25519_init();
    sha256_global_init();
    var sig_hex = pdbe_signature(entry);
    if (str_len(sig_hex) == 0) { return 0; }
    # Rebuild canonical message
    var sb = str_builder_new();
    str_builder_add(sb, pdbe_name(entry));
    str_builder_add_cstr(sb, ":");
    str_builder_add(sb, pdbe_version(entry));
    var fls = pdbe_files(entry);
    var i = 0;
    while (i < vec_len(fls)) {
        str_builder_add_cstr(sb, ":");
        var h = pdbe_get_file_hash(entry, vec_get(fls, i));
        if (h > 0) { str_builder_add(sb, h); }
        else {
            # Recompute from disk
            var fpath = vec_get(fls, i);
            var disk_hash = hash_file(str_data(fpath));
            if (disk_hash > 0) { str_builder_add(sb, disk_hash); }
        }
        i = i + 1;
    }
    var msg = str_builder_build(sb);
    var sig = hex_decode(str_data(sig_hex), str_len(sig_hex));
    if (sig == 0) { return 0; }
    return verify_data(str_data(msg), str_len(msg), sig, public_key);
}

# =========================================================================
# PackageDb - hashmap-backed
# Fields: packages(0) db_path(8)   => 16 bytes
# =========================================================================

var PDB_SZ = 24;

fn pdb_map(p) { return load64(p); }
fn pdb_path(p) { return load64(p + 8); }
# 1 = the on-disk DB loaded cleanly (or there was none); 0 = the load was
# truncated/corrupt, so the in-memory map is known-incomplete and pkg_db_save
# refuses to overwrite the file (else a partial load would wipe real records).
fn pdb_loaded_ok(p) { return load64(p + 16); }
fn pdb_set_loaded_ok(p, v) { store64(p + 16, v); }

fn pkg_db_new() {
    var p = alloc(PDB_SZ);
    store64(p, map_new());
    store64(p + 8, str_from(""));
    store64(p + 16, 1);
    return p;
}

# Current database schema version
var DB_SCHEMA_VERSION = 3;
# v1: original (name, version, source, size, held)
# v2: (declared) file_checksums/signature/signer/pins — but save never wrote them
# v3: full round-trip — pkg_db_load now reconstructs entries, and pkg_db_save
#     persists pins + owned files + per-file hashes + provenance. Older v1/v2
#     files load with defaults for any missing field (load guards absent keys).

# DOM-value field readers (return a default when the key is absent or wrong-typed).
# NOTE: keys MUST be raw cstr literals — bayan_json_v_obj_get does strlen/memeq on
# a char*, so a str_from() key silently returns 0.
fn pdb_v_int_or(obj, key, dflt) {
    var v = bayan_json_v_obj_get(obj, key);
    if (v == 0) { return dflt; }
    if (bayan_json_v_is_int(v) == 0) { return dflt; }
    return bayan_json_v_int(v);
}
fn pdb_v_str_or(obj, key, dflt) {
    var v = bayan_json_v_obj_get(obj, key);
    if (v == 0) { return dflt; }
    if (bayan_json_v_is_str(v) == 0) { return dflt; }
    return bayan_json_v_str(v);
}

# Reconstruct a PackageDbEntry from its parsed JSON object node.
fn pdb_entry_from_json(name, e) {
    var entry = db_entry_new(name, pdb_v_str_or(e, "version", str_from("")), pdb_v_int_or(e, "source", 0));
    pdbe_set_size(entry, pdb_v_int_or(e, "size_bytes", 0));
    pdbe_set_held(entry, pdb_v_int_or(e, "held", 0));
    pdbe_set_checksum(entry, pdb_v_str_or(e, "checksum", str_from("")));
    pdbe_set_signature(entry, pdb_v_str_or(e, "signature", str_from("")));
    pdbe_set_signer(entry, pdb_v_str_or(e, "signer", str_from("")));
    pdbe_set_pinned_ver(entry, pdb_v_str_or(e, "pinned_version", str_from("")));
    # pinned_source: -1 is "unset" and 0 is a real source, so default to -1.
    pdbe_set_pinned_src(entry, pdb_v_int_or(e, "pinned_source", 0 - 1));
    pdbe_set_installed_by(entry, pdb_v_str_or(e, "installed_by", str_from("root")));
    var ia = pdb_v_int_or(e, "installed_at", 0);
    if (ia > 0) { pdbe_set_installed_at(entry, ia); }
    # Owned files (array of paths).
    var farr = bayan_json_v_obj_get(e, "files");
    if (farr != 0) {
        if (bayan_json_v_is_arr(farr) == 1) {
            var fl = bayan_json_v_arr_len(farr);
            var fj = 0;
            while (fj < fl) {
                var fv = bayan_json_v_arr_get(farr, fj);
                if (bayan_json_v_is_str(fv) == 1) { vec_push(pdbe_files(entry), bayan_json_v_str(fv)); }
                fj = fj + 1;
            }
        }
    }
    # Per-file SHA-256 hashes (object path->hex).
    var fco = bayan_json_v_obj_get(e, "file_checksums");
    if (fco != 0) {
        if (bayan_json_v_is_obj(fco) == 1) {
            var fcn = bayan_json_v_obj_len(fco);
            var fk = 0;
            while (fk < fcn) {
                var fpath = bayan_json_v_obj_key(fco, fk);
                var fhv = bayan_json_v_obj_val(fco, fk);
                if (bayan_json_v_is_str(fhv) == 1) { pdbe_set_file_hash(entry, fpath, bayan_json_v_str(fhv)); }
                fk = fk + 1;
            }
        }
    }
    return entry;
}

fn pkg_db_load(path) {
    var p = alloc(PDB_SZ);
    store64(p, map_new());
    store64(p + 8, path);
    store64(p + 16, 1);
    # Read the whole file. file_read_all caps at maxlen and gives no truncation
    # signal, so grow the buffer until a read no longer fills it (EOF reached) —
    # a truncated read would parse as empty and the next save would WIPE the
    # on-disk DB (review #2). 64 MiB ceiling is far past any real package set.
    var cap = 524288;
    var buf = alloc(cap);
    var bytes = file_read_all(str_data(path), buf, cap);
    while (bytes >= cap && cap < 67108864) {
        cap = cap * 2;
        buf = alloc(cap);
        bytes = file_read_all(str_data(path), buf, cap);
    }
    if (bytes <= 0) { return p; }
    if (bytes >= cap) {
        # Still truncated at the ceiling — refuse to load (and to later clobber).
        pdb_set_loaded_ok(p, 0);
        return p;
    }
    var content = str_new(buf, bytes);
    # Parse with the DOM value parser, invoked the only way that works in cyrius
    # 6.3.5: the explicit buf+len entry. json_v_parse(Str) mis-dispatches via the
    # _str overload routing (drops the len, reads 0, returns 0) — see mela.cyr.
    var root = bayan_json_v_parse_str(str_data(content), str_len(content));
    if (root == 0) {
        # A non-empty file that won't parse is corrupt — don't let a save clobber it.
        pdb_set_loaded_ok(p, 0);
        return p;
    }
    if (bayan_json_v_is_obj(root) == 0) { pdb_set_loaded_ok(p, 0); return p; }
    var pkgs = bayan_json_v_obj_get(root, "packages");
    if (pkgs == 0) { return p; }
    if (bayan_json_v_is_obj(pkgs) == 0) { return p; }
    var n = bayan_json_v_obj_len(pkgs);
    var i = 0;
    while (i < n) {
        var name = bayan_json_v_obj_key(pkgs, i);
        var e = bayan_json_v_obj_val(pkgs, i);
        if (bayan_json_v_is_obj(e) == 1) {
            map_set(pdb_map(p), str_data(name), pdb_entry_from_json(name, e));
        }
        i = i + 1;
    }
    return p;
}

fn json_escape_str(sb, s) {
    var d = str_data(s);
    var n = str_len(s);
    var i = 0;
    while (i < n) {
        # Find run of safe characters (no escaping needed)
        var run_start = i;
        while (i < n) {
            var c = load8(d + i);
            if (c == 34 || c == 92 || c < 32) { break; }
            i = i + 1;
        }
        # Emit the safe run as a single Str slice (zero-copy)
        if (i > run_start) {
            str_builder_add(sb, str_new(d + run_start, i - run_start));
        }
        # Handle special character if we stopped on one
        if (i < n) {
            var c = load8(d + i);
            if (c == 34) { str_builder_add_cstr(sb, "\\\""); }
            elif (c == 92) { str_builder_add_cstr(sb, "\\\\"); }
            elif (c == 10) { str_builder_add_cstr(sb, "\\n"); }
            elif (c == 13) { str_builder_add_cstr(sb, "\\r"); }
            elif (c == 9) { str_builder_add_cstr(sb, "\\t"); }
            else {
                # Other control bytes (0x00-0x1F) -> the real \u00XX escape, not a
                # fixed \0 (which would corrupt the byte to NUL on reload).
                str_builder_add_cstr(sb, "\\u00");
                var hi = (c >> 4) & 15;
                var lo = c & 15;
                if (hi < 10) { str_builder_add_byte(sb, hi + 48); } else { str_builder_add_byte(sb, hi + 87); }
                if (lo < 10) { str_builder_add_byte(sb, lo + 48); } else { str_builder_add_byte(sb, lo + 87); }
            }
            i = i + 1;
        }
    }
}

fn pkg_db_save(db) {
    if (str_len(pdb_path(db)) == 0) { return 1; }
    # The on-disk DB failed to load (truncated past the ceiling, or corrupt) — the
    # in-memory map is known-incomplete, so overwriting would destroy real records.
    if (pdb_loaded_ok(db) == 0) {
        var w = str_from("ark: refusing to save — package DB failed to load; on-disk file left intact\n");
        print(str_data(w), str_len(w));
        return 0;
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"schema_version\":");
    str_builder_add_int(sb, DB_SCHEMA_VERSION);
    str_builder_add_cstr(sb, ",\"packages\":{");
    var all = pkg_db_list(db);
    var i = 0;
    while (i < vec_len(all)) {
        var entry = vec_get(all, i);
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "\"");
        json_escape_str(sb, pdbe_name(entry));
        str_builder_add_cstr(sb, "\":{\"name\":\"");
        json_escape_str(sb, pdbe_name(entry));
        str_builder_add_cstr(sb, "\",\"version\":\"");
        json_escape_str(sb, pdbe_version(entry));
        str_builder_add_cstr(sb, "\",\"source\":");
        str_builder_add_int(sb, pdbe_source(entry));
        str_builder_add_cstr(sb, ",\"size_bytes\":");
        str_builder_add_int(sb, pdbe_size(entry));
        str_builder_add_cstr(sb, ",\"held\":");
        str_builder_add_int(sb, pdbe_held(entry));
        str_builder_add_cstr(sb, ",\"installed_at\":");
        str_builder_add_int(sb, pdbe_installed_at(entry));
        str_builder_add_cstr(sb, ",\"installed_by\":\"");
        json_escape_str(sb, pdbe_installed_by(entry));
        str_builder_add_cstr(sb, "\",\"checksum\":\"");
        json_escape_str(sb, pdbe_checksum(entry));
        str_builder_add_cstr(sb, "\",\"signature\":\"");
        json_escape_str(sb, pdbe_signature(entry));
        str_builder_add_cstr(sb, "\",\"signer\":\"");
        json_escape_str(sb, pdbe_signer(entry));
        str_builder_add_cstr(sb, "\",\"pinned_version\":\"");
        json_escape_str(sb, pdbe_pinned_ver(entry));
        # pinned_source: emit the raw int incl. the -1 "unset" sentinel (0 is a
        # real source, so the field must be explicit, not omitted).
        str_builder_add_cstr(sb, "\",\"pinned_source\":");
        str_builder_add_int(sb, pdbe_pinned_src(entry));
        # Owned files + per-file hashes, driven by the files list so the array
        # and the checksum map stay consistent.
        str_builder_add_cstr(sb, ",\"files\":[");
        var fls = pdbe_files(entry);
        var fi = 0;
        while (fi < vec_len(fls)) {
            if (fi > 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "\"");
            json_escape_str(sb, vec_get(fls, fi));
            str_builder_add_cstr(sb, "\"");
            fi = fi + 1;
        }
        str_builder_add_cstr(sb, "],\"file_checksums\":{");
        var first_fc = 1;
        var fhi = 0;
        while (fhi < vec_len(fls)) {
            var fp = vec_get(fls, fhi);
            var h = pdbe_get_file_hash(entry, fp);
            if (h != 0) {
                if (first_fc == 0) { str_builder_add_cstr(sb, ","); }
                first_fc = 0;
                str_builder_add_cstr(sb, "\"");
                json_escape_str(sb, fp);
                str_builder_add_cstr(sb, "\":\"");
                json_escape_str(sb, h);
                str_builder_add_cstr(sb, "\"");
            }
            fhi = fhi + 1;
        }
        str_builder_add_cstr(sb, "}}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "}}");
    var json = str_builder_build(sb);
    # Ensure the DB's parent dir exists before the temp open. On a fresh system
    # /var/lib/agnos/ark is absent; under --root it's <root>/var/lib/agnos/ark
    # (also absent). O_CREAT below makes the FILE, not the dir, so without this the
    # temp open fails fd<0 and pkg_db_save silently `return 0`s — install reports
    # success while NO record persists. mkdir -p the parent (mkdir#9 seam op).
    apkg_mkdir_parents(str_data(pdb_path(db)));
    # Secure temp: random suffix, O_CREAT|O_EXCL|O_WRONLY, mode 0600
    var tmp_sb = str_builder_new();
    str_builder_add(tmp_sb, pdb_path(db));
    str_builder_add_cstr(tmp_sb, ".tmp.");
    str_builder_add_int(tmp_sb, syscall(SYS_GETPID));
    var tmp_path = str_builder_build(tmp_sb);
    var tmp_cstr = str_data(tmp_path);
    # Secure temp: O_WRONLY | O_CREAT | O_EXCL (named flags, no magic 193),
    # mode 0600 = 384. open/write/close go through the portable file_* wrappers
    # and fsync + atomic rename through the portable shims, so the agnos
    # cross-build resolves the right Sys numbers / ABIs (M3).
    var fd = file_open(tmp_cstr, O_WRONLY | O_CREAT | O_EXCL, 384);
    if (fd < 0) { return 0; }
    file_write(fd, str_data(json), str_len(json));
    ark_fsync(fd);
    file_close(fd);
    ark_rename(tmp_cstr, str_data(pdb_path(db)));
    return 1;
}

fn pkg_db_register(db, entry) {
    map_set(pdb_map(db), str_data(pdbe_name(entry)), entry);
}

fn pkg_db_unregister(db, name) {
    var entry = map_get(pdb_map(db), str_data(name));
    if (entry > 0) { map_delete(pdb_map(db), str_data(name)); return entry; }
    return 0;
}

fn pkg_db_get(db, name) { return map_get(pdb_map(db), name); }
fn pkg_db_is_installed(db, name) { return map_get(pdb_map(db), str_data(name)) > 0; }
# 1 when `name` is installed AND held (upgrades must skip it). 0 otherwise.
fn pkg_db_is_held(db, name) {
    var e = map_get(pdb_map(db), str_data(name));
    if (e == 0) { return 0; }
    return pdbe_held(e);
}
fn pkg_db_count(db) { return map_count(pdb_map(db)); }

fn pkg_db_list(db) {
    return map_values(pdb_map(db));
}

fn to_lower_byte(c) {
    if (c >= 65 && c <= 90) { return c + 32; }
    return c;
}

fn str_contains_icase(haystack, needle) {
    var hd = str_data(haystack);
    var hn = str_len(haystack);
    var nd = str_data(needle);
    var nn = str_len(needle);
    if (nn == 0) { return 1; }
    if (nn > hn) { return 0; }
    var i = 0;
    while (i <= hn - nn) {
        var j = 0;
        while (j < nn) {
            if (to_lower_byte(load8(hd + i + j)) != to_lower_byte(load8(nd + j))) {
                j = nn + 1;
            } else { j = j + 1; }
        }
        if (j == nn) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn pkg_db_search(db, query) {
    var result = vec_new();
    var all = pkg_db_list(db);
    var i = 0;
    while (i < vec_len(all)) {
        var entry = vec_get(all, i);
        if (str_contains_icase(pdbe_name(entry), query)) { vec_push(result, entry); }
        i = i + 1;
    }
    return result;
}

fn pkg_db_by_source(db, source) {
    var result = vec_new();
    var all = pkg_db_list(db);
    var i = 0;
    while (i < vec_len(all)) {
        var entry = vec_get(all, i);
        if (pdbe_source(entry) == source) { vec_push(result, entry); }
        i = i + 1;
    }
    return result;
}

fn pkg_db_total_size(db) {
    var total = 0;
    var all = pkg_db_list(db);
    var i = 0;
    while (i < vec_len(all)) { total = total + pdbe_size(vec_get(all, i)); i = i + 1; }
    return total;
}

# IntegrityIssue: [name(Str), type(i64), detail(Str)]
# type: 0=NoFileManifest, 1=MissingFile, 2=ChecksumMismatch
var ISSUE_NO_MANIFEST = 0;
var ISSUE_MISSING_FILE = 1;
var ISSUE_CHECKSUM_MISMATCH = 2;

var IISSUE_SZ = 24;
fn iissue_name(p) { return load64(p); }
fn iissue_type(p) { return load64(p + 8); }
fn iissue_detail(p) { return load64(p + 16); }

fn integrity_issue(name, itype, detail) {
    var p = alloc(IISSUE_SZ);
    store64(p, name);
    store64(p + 8, itype);
    store64(p + 16, detail);
    return p;
}

# Quick check: packages with empty file manifests (no disk I/O)
fn pkg_db_check_integrity(db) {
    var issues = vec_new();
    var all = pkg_db_list(db);
    var i = 0;
    while (i < vec_len(all)) {
        var entry = vec_get(all, i);
        if (vec_len(pdbe_files(entry)) == 0) {
            vec_push(issues, integrity_issue(
            pdbe_name(entry), ISSUE_NO_MANIFEST, str_from("")));
        }
        i = i + 1;
    }
    return issues;
}

# Full check: verify files exist and checksums match (disk I/O)
# If pkg_filter is non-empty, only check that package.
fn pkg_db_check_integrity_full(db, pkg_filter) {
    sha256_global_init();
    var issues = vec_new();
    var all = pkg_db_list(db);
    var i = 0;
    while (i < vec_len(all)) {
        var entry = vec_get(all, i);
        # Apply filter
        if (str_len(pkg_filter) > 0) {
            if (str_eq(pdbe_name(entry), pkg_filter) == 0) {
                i = i + 1;
                continue;
            }
        }
        var fls = pdbe_files(entry);
        if (vec_len(fls) == 0) {
            vec_push(issues, integrity_issue(
            pdbe_name(entry), ISSUE_NO_MANIFEST, str_from("")));
            i = i + 1;
            continue;
        }
        var j = 0;
        while (j < vec_len(fls)) {
            var fpath = vec_get(fls, j);
            if (file_exists(str_data(fpath)) == 0) {
                vec_push(issues, integrity_issue(
                pdbe_name(entry), ISSUE_MISSING_FILE, fpath));
                j = j + 1;
                continue;
            }
            # Check per-file hash first, fall back to legacy single checksum
            var expected = pdbe_get_file_hash(entry, fpath);
            if (expected == 0) { expected = pdbe_checksum(entry); }
            if (expected > 0 && str_len(expected) > 0) {
                var actual = hash_file(str_data(fpath));
                if (actual > 0) {
                    if (str_eq(actual, expected) == 0) {
                        vec_push(issues, integrity_issue(
                        pdbe_name(entry), ISSUE_CHECKSUM_MISMATCH,
                        fpath));
                    }
                } else {
                    vec_push(issues, integrity_issue(
                    pdbe_name(entry), ISSUE_MISSING_FILE, fpath));
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return issues;
}

fn pkg_db_hold(db, name) {
    var entry = pkg_db_get(db, str_data(name));
    if (entry > 0) { pdbe_set_held(entry, 1); return 1; }
    return 0;
}

fn pkg_db_unhold(db, name) {
    var entry = pkg_db_get(db, str_data(name));
    if (entry > 0) { pdbe_set_held(entry, 0); return 1; }
    return 0;
}

fn pkg_db_held_packages(db) {
    var result = vec_new();
    var all = pkg_db_list(db);
    var i = 0;
    while (i < vec_len(all)) {
        var entry = vec_get(all, i);
        if (pdbe_held(entry)) { vec_push(result, entry); }
        i = i + 1;
    }
    return result;
}

# =========================================================================
# Package pinning: lock version and/or source
# =========================================================================

# Pin a package to its current version. Returns 1 if found.
fn pkg_db_pin_version(db, name) {
    var entry = pkg_db_get(db, str_data(name));
    if (entry > 0) {
        pdbe_set_pinned_ver(entry, pdbe_version(entry));
        return 1;
    }
    return 0;
}

# Pin a package to a specific version string.
fn pkg_db_pin_version_to(db, name, version) {
    var entry = pkg_db_get(db, str_data(name));
    if (entry > 0) { pdbe_set_pinned_ver(entry, version); return 1; }
    return 0;
}

# Pin a package to its current source. Returns 1 if found.
fn pkg_db_pin_source(db, name) {
    var entry = pkg_db_get(db, str_data(name));
    if (entry > 0) {
        pdbe_set_pinned_src(entry, pdbe_source(entry));
        return 1;
    }
    return 0;
}

# Unpin version for a package.
fn pkg_db_unpin_version(db, name) {
    var entry = pkg_db_get(db, str_data(name));
    if (entry > 0) { pdbe_set_pinned_ver(entry, str_from("")); return 1; }
    return 0;
}

# Unpin source for a package.
fn pkg_db_unpin_source(db, name) {
    var entry = pkg_db_get(db, str_data(name));
    if (entry > 0) { pdbe_set_pinned_src(entry, 0 - 1); return 1; }
    return 0;
}

# Check if an upgrade to a new version is allowed by pinning.
# Returns 1 if allowed, 0 if blocked.
fn pkg_db_upgrade_allowed(db, name, new_version, new_source) {
    var entry = pkg_db_get(db, str_data(name));
    if (entry == 0) { return 1; }
    # Check version pin
    var pv = pdbe_pinned_ver(entry);
    if (str_len(pv) > 0) {
        if (str_eq(pv, new_version) == 0) { return 0; }
    }
    # Check source pin
    var ps = pdbe_pinned_src(entry);
    if (ps >= 0 && ps != new_source) { return 0; }
    return 1;
}

# List all pinned packages
fn pkg_db_pinned_packages(db) {
    var result = vec_new();
    var all = pkg_db_list(db);
    var i = 0;
    while (i < vec_len(all)) {
        var entry = vec_get(all, i);
        var has_pin = 0;
        if (str_len(pdbe_pinned_ver(entry)) > 0) { has_pin = 1; }
        if (pdbe_pinned_src(entry) >= 0) { has_pin = 1; }
        if (has_pin) { vec_push(result, entry); }
        i = i + 1;
    }
    return result;
}

fn pkg_db_files_for(db, name) {
    var entry = pkg_db_get(db, str_data(name));
    if (entry > 0) { return pdbe_files(entry); }
    return vec_new();
}

fn pkg_db_owner_of(db, file_path) {
    var all = pkg_db_list(db);
    var i = 0;
    while (i < vec_len(all)) {
        var entry = vec_get(all, i);
        var j = 0;
        var fls = pdbe_files(entry);
        while (j < vec_len(fls)) {
            if (str_eq(vec_get(fls, j), file_path)) { return pdbe_name(entry); }
            j = j + 1;
        }
        i = i + 1;
    }
    return str_from("");
}

# Topological sort for dependency resolution
fn resolve_visit(db, pkg, all, visited, visiting, order) {
    var pkg_cstr = str_data(pkg);
    if (map_has(visited, pkg_cstr)) { return 1; }
    if (map_has(visiting, pkg_cstr)) { return 0; }
    map_set(visiting, pkg_cstr, 1);
    var entry = pkg_db_get(db, pkg_cstr);
    if (entry > 0) {
        var deps = pdbe_deps(entry);
        var i = 0;
        while (i < vec_len(deps)) {
            var dep = vec_get(deps, i);
            var j = 0;
            var in_set = 0;
            while (j < vec_len(all)) {
                if (str_eq(vec_get(all, j), dep)) { in_set = 1; }
                j = j + 1;
            }
            if (in_set) {
                if (resolve_visit(db, dep, all, visited, visiting, order) == 0) { return 0; }
            }
            i = i + 1;
        }
    }
    map_set(visiting, pkg_cstr, 0);
    map_set(visited, pkg_cstr, 1);
    vec_push(order, pkg);
    return 1;
}

fn pkg_db_resolve_install_order(db, to_install) {
    var order = vec_new();
    var visited = map_new();
    var visiting = map_new();
    var i = 0;
    while (i < vec_len(to_install)) {
        if (resolve_visit(db, vec_get(to_install, i), to_install, visited, visiting, order) == 0) {
            return Err(1);
        }
        i = i + 1;
    }
    return Ok(order);
}
