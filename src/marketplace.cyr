# =========================================================================
# marketplace.cyr — download a `.ark` from a mela marketplace, then install.
#
# Division of labour: mela (the marketplace layer) validates the
# name/version and builds the artifact URL; sandhi (mela's own HTTP/TLS
# client) transports it; ark's native installer (ark_pkg_install, 0.8.6)
# verifies + materializes + registers. mela 0.9.x's own artifact
# fetch+write is deferred (mela ADR-0006), so ark performs the GET here
# using the same sandhi client mela uses for search/manifest.
#
# A cache hit (the `.ark` already present under cache_dir) skips the
# network entirely — which also makes the install path offline-testable.
# =========================================================================

# Local cache path for an artifact: <cache_dir>/<name>-<version>.ark, with
# mela's filename sanitization. Returns a Str path.
fn ark_marketplace_cache_path(cache_dir, name, version) {
    # Sanitize name + version separately (mela's sanitizer maps '.' -> '_'),
    # then append a literal ".ark" so the cached artifact keeps its extension.
    var fname = str_cat(str_cat(sanitize_filename(name), str_from("-")),
    str_cat(sanitize_filename(version), str_from(".ark")));
    return path_join(cache_dir, fname);
}

# Download a marketplace package's `.ark` from `base_url` (skipping the fetch
# on a cache hit), then install it via the native installer. ark drives mela's
# registry client — `mela_fetch_artifact` (mela 0.9.5) applies the download
# guards + sandhi HTTP/TLS transport and writes the artifact verbatim to ark's
# chosen `.ark` cache path (format-agnostic, not mela's `.agnos-agent` layout);
# then ark_pkg_install verifies, lays down, and registers. `install_root` "" = real root.
fn ark_marketplace_install(mgr, base_url, cache_dir, name, version, install_root, max_len) {
    if (validate_path_segment(name) == 0) {
        return ark_result_new(0, str_from("ark: invalid marketplace package name"),
        vec_new(), SOURCE_MARKETPLACE);
    }
    if (validate_path_segment(version) == 0) {
        return ark_result_new(0, str_from("ark: invalid marketplace package version"),
        vec_new(), SOURCE_MARKETPLACE);
    }
    var cache_path = ark_marketplace_cache_path(cache_dir, name, version);
    var cpath = str_data(cache_path);
    if (file_exists(cpath) == 0) {
        apkg_mkdir_p(str_data(cache_dir));
        var client = registry_client_new(base_url, cache_dir);
        var n = mela_fetch_artifact(client, name, version, cache_path);
        if (n <= 0) {
            return ark_result_new(0,
            str_from("ark: marketplace download failed (offline or server unavailable)"),
            vec_new(), SOURCE_MARKETPLACE);
        }
    }
    var iroot = "";
    if (install_root != 0) {
        if (str_len(install_root) > 0) { iroot = str_data(install_root); }
    }
    # Marketplace is an untrusted source: always require a trusted signer
    # (fail closed), regardless of the global require_signed default.
    acfg_set_require_signed(amgr_config(mgr), 1);
    return ark_pkg_install(mgr, cpath, iroot, max_len);
}

# CLI glue: `ark install name@version --marketplace URL [--root DIR]`. Splits
# the `name@version` arg and resolves the cache dir from config, then runs the
# marketplace install. Requires an explicit version (no server round-trip to
# resolve "latest" yet).
fn ark_marketplace_install_arg(mgr, url, pkg_arg, root) {
    var data = str_data(pkg_arg);
    var n = str_len(pkg_arg);
    var at = 0 - 1;
    var i = 0;
    while (i < n) {
        if (load8(data + i) == 64) { at = i; break; }
        i = i + 1;
    }
    if (at <= 0 || at >= n - 1) {
        return ark_result_new(0, str_from("ark: marketplace install needs name@version"),
        vec_new(), SOURCE_MARKETPLACE);
    }
    var name = str_new(data, at);
    var version = str_new(data + at + 1, n - at - 1);
    var cache_dir = acfg_cache_dir(amgr_config(mgr));
    return ark_marketplace_install(mgr, url, cache_dir, name, version, root, 134217728);
}
