# ark - Unified Package Manager CLI for AGNOS
# Ported from 4363 lines of Rust
#
# ark is the user-facing CLI for AGNOS package management. It translates
# user commands into operations, using the nous resolver to figure out where
# packages come from (system apt, marketplace agents, or Flutter app bundles),
# then produces execution plans that callers can run with appropriate
# permissions via shakti.
#
# ark does NOT directly execute apt-get or dpkg. It generates InstallPlan
# instructions - a deliberate security design choice.

# Stdlib auto-included via cyrius.cyml

# =========================================================================
# Constants
# =========================================================================

var ARK_VERSION_STR = "1.1.2";

var DEFAULT_TRANSACTION_LOG_PATH = "/var/lib/agnos/ark/transaction.log";
var DEFAULT_PACKAGE_DB_PATH = "/var/lib/agnos/ark/packages.json";
var DEFAULT_SHAKTI_PATH = "/usr/bin/shakti";
var DEFAULT_TRUST_KEYS_PATH = "/etc/agnos/ark/trusted_keys";
# apt-agnos backend: the AGNOS syscall-wrapper command apt/dpkg are fronted
# by, so the unmodified Debian toolchain runs under AGNOS (ADR 0002). ark does
# NOT implement the wrapper — it only prefixes apt argv with it; AGNOS owns the
# shim's shape, so the path is configurable. Default is a bare command (PATH).
var DEFAULT_APT_WRAPPER = "apt-agnos";

# ANSI color codes
var ANSI_RESET = "\x1b[0m";
var ANSI_BOLD = "\x1b[1m";
var ANSI_GREEN = "\x1b[32m";
var ANSI_RED = "\x1b[31m";
var ANSI_YELLOW = "\x1b[33m";
var ANSI_CYAN = "\x1b[36m";

# =========================================================================
# PackageSource + ResolutionStrategy: provided by nous
# Aliases for ark's naming convention
# =========================================================================

# source_to_str(src) is provided by nous (returns Str)
# source_to_cstr: ark wrapper returning cstr for output formatting
fn source_to_cstr(src) {
    return str_data(source_to_str(src));
}

fn parse_source_str(s) {
    if (streq(s, "system")) { return Ok(SOURCE_SYSTEM); }
    if (streq(s, "apt")) { return Ok(SOURCE_SYSTEM); }
    if (streq(s, "marketplace")) { return Ok(SOURCE_MARKETPLACE); }
    if (streq(s, "market")) { return Ok(SOURCE_MARKETPLACE); }
    if (streq(s, "flutter")) { return Ok(SOURCE_FLUTTER_APP); }
    if (streq(s, "flutter-app")) { return Ok(SOURCE_FLUTTER_APP); }
    if (streq(s, "flutterapp")) { return Ok(SOURCE_FLUTTER_APP); }
    return Err(1);
}

# Strategy names: use nous STRAT_* enum values directly

fn strategy_to_str(s) {
    if (s == STRAT_MARKETPLACE_FIRST) { return "MarketplaceFirst"; }
    if (s == STRAT_SYSTEM_FIRST) { return "SystemFirst"; }
    if (s == STRAT_ONLY_SOURCE) { return "OnlySource"; }
    if (s == STRAT_SEARCH_ALL) { return "SearchAll"; }
    return "Unknown";
}

# =========================================================================
# SystemBackend — how the SOURCE_SYSTEM path resolves + executes (ADR 0002).
# The backend mode decides the *inner* command; shakti still escalates
# (ADR 0001). One seam, three interchangeable implementations:
#   apt        — `apt-get …` directly (Debian dev/CI, Debian-base hosts).
#   apt-agnos  — apt-get fronted by the AGNOS syscall wrapper (interim AGNOS
#                bridge, until native lands). ark only prefixes the wrapper.
#   native     — ark's own `.ark` installer + PackageDb store, no apt (AGNOS
#                target). System steps route to the native installer.
# =========================================================================

enum SystemBackend {
    BACKEND_APT = 0;
    BACKEND_APT_AGNOS = 1;
    BACKEND_NATIVE = 2;
}

fn backend_to_str(b) {
    if (b == BACKEND_APT) { return "apt"; }
    if (b == BACKEND_APT_AGNOS) { return "apt-agnos"; }
    if (b == BACKEND_NATIVE) { return "native"; }
    return "unknown";
}

# Parse a backend name to its enum value; Err(1) on an unknown name.
fn parse_backend_str(s) {
    if (streq(s, "apt")) { return Ok(BACKEND_APT); }
    if (streq(s, "apt-agnos")) { return Ok(BACKEND_APT_AGNOS); }
    if (streq(s, "aptagnos")) { return Ok(BACKEND_APT_AGNOS); }
    if (streq(s, "native")) { return Ok(BACKEND_NATIVE); }
    return Err(1);
}

# =========================================================================
# ArkCommand - tagged struct with accessors
# Fields: tag(0) packages(8) query(16) group(24) package(32) source(40)
#         force(48) purge(56) count(64)   => 72 bytes
# =========================================================================

enum ArkCommandTag {
    CMD_INSTALL = 0;
    CMD_GROUP_INSTALL = 1;
    CMD_REMOVE = 2;
    CMD_SEARCH = 3;
    CMD_LIST = 4;
    CMD_INFO = 5;
    CMD_UPDATE = 6;
    CMD_UPGRADE = 7;
    CMD_STATUS = 8;
    CMD_HOLD = 9;
    CMD_UNHOLD = 10;
    CMD_VERIFY = 11;
    CMD_HISTORY = 12;
    CMD_PIN = 13;
    CMD_UNPIN = 14;
    CMD_ROLLBACK = 15;
    CMD_BACKUP = 16;
    CMD_RESTORE = 17;
    CMD_BAZAAR = 18;
}

var ACMD_SZ = 88;

fn acmd_tag(p) { return load64(p); }
fn acmd_set_tag(p, v) { store64(p, v); }
fn acmd_packages(p) { return load64(p + 8); }
fn acmd_set_packages(p, v) { store64(p + 8, v); }
fn acmd_query(p) { return load64(p + 16); }
fn acmd_set_query(p, v) { store64(p + 16, v); }
fn acmd_group(p) { return load64(p + 24); }
fn acmd_set_group(p, v) { store64(p + 24, v); }
fn acmd_package(p) { return load64(p + 32); }
fn acmd_set_package(p, v) { store64(p + 32, v); }
fn acmd_source(p) { return load64(p + 40); }
fn acmd_set_source(p, v) { store64(p + 40, v); }
fn acmd_force(p) { return load64(p + 48); }
fn acmd_set_force(p, v) { store64(p + 48, v); }
fn acmd_purge(p) { return load64(p + 56); }
fn acmd_set_purge(p, v) { store64(p + 56, v); }
fn acmd_count(p) { return load64(p + 64); }
fn acmd_set_count(p, v) { store64(p + 64, v); }
# Install root for local `.ark` install (`--root DIR`); "" = real root.
fn acmd_root(p) { return load64(p + 72); }
fn acmd_set_root(p, v) { store64(p + 72, v); }
# Marketplace base URL (`--marketplace URL`) for `ark install name@version`; "" = none.
fn acmd_mkt_url(p) { return load64(p + 80); }
fn acmd_set_mkt_url(p, v) { store64(p + 80, v); }

fn ark_cmd_new(tag) {
    var p = alloc(ACMD_SZ);
    acmd_set_tag(p, tag);
    acmd_set_packages(p, vec_new());
    acmd_set_query(p, str_from(""));
    acmd_set_group(p, str_from(""));
    acmd_set_package(p, str_from(""));
    acmd_set_source(p, 0 - 1);
    acmd_set_force(p, 0);
    acmd_set_purge(p, 0);
    acmd_set_count(p, 0 - 1);
    acmd_set_root(p, str_from(""));
    acmd_set_mkt_url(p, str_from(""));
    return p;
}
# =========================================================================
# InstallStep
# Fields: tag(0) package(8) version(16) purge(24)   => 32 bytes
# =========================================================================

enum InstallStepTag {
    STEP_SYSTEM_INSTALL = 0;
    STEP_SYSTEM_REMOVE = 1;
    STEP_MARKETPLACE_INSTALL = 2;
    STEP_MARKETPLACE_REMOVE = 3;
    STEP_FLUTTER_INSTALL = 4;
    STEP_FLUTTER_REMOVE = 5;
    STEP_SYSTEM_UPDATE = 6;
}

var ISTEP_SZ = 32;

fn istep_tag(p) { return load64(p); }
fn istep_pkg(p) { return load64(p + 8); }
fn istep_ver(p) { return load64(p + 16); }
fn istep_purge(p) { return load64(p + 24); }

fn step_new(tag, pkg, ver, purge) {
    var p = alloc(ISTEP_SZ);
    store64(p, tag);
    store64(p + 8, pkg);
    store64(p + 16, ver);
    store64(p + 24, purge);
    return p;
}

fn step_system_install(pkg, ver) { return step_new(STEP_SYSTEM_INSTALL, pkg, ver, 0); }
fn step_system_remove(pkg, purge) { return step_new(STEP_SYSTEM_REMOVE, pkg, str_from(""), purge); }
fn step_marketplace_install(pkg, ver) { return step_new(STEP_MARKETPLACE_INSTALL, pkg, ver, 0); }
fn step_marketplace_remove(pkg) { return step_new(STEP_MARKETPLACE_REMOVE, pkg, str_from(""), 0); }
fn step_flutter_install(pkg, ver) { return step_new(STEP_FLUTTER_INSTALL, pkg, ver, 0); }
fn step_flutter_remove(pkg) { return step_new(STEP_FLUTTER_REMOVE, pkg, str_from(""), 0); }
fn step_system_update() { return step_new(STEP_SYSTEM_UPDATE, str_from(""), str_from(""), 0); }

# =========================================================================
# InstallPlan
# Fields: steps(0) requires_root(8) estimated_size_bytes(16)   => 24 bytes
# =========================================================================

var IPLAN_SZ = 24;

fn iplan_steps(p) { return load64(p); }
fn iplan_root(p) { return load64(p + 8); }
fn iplan_set_root(p, v) { store64(p + 8, v); }
fn iplan_size(p) { return load64(p + 16); }
fn iplan_add_size(p, v) { store64(p + 16, load64(p + 16) + v); }

fn install_plan_new() {
    var p = alloc(IPLAN_SZ);
    store64(p, vec_new());
    store64(p + 8, 0);
    store64(p + 16, 0);
    return p;
}

# =========================================================================
# ArkResult
# Fields: success(0) message(8) packages_affected(16) source(24) => 32 bytes
# =========================================================================

var ARES_SZ = 32;

fn ares_success(p) { return load64(p); }
fn ares_message(p) { return load64(p + 8); }
fn ares_packages(p) { return load64(p + 16); }
fn ares_source(p) { return load64(p + 24); }

fn ark_result_new(success, message, packages, source) {
    var p = alloc(ARES_SZ);
    store64(p, success);
    store64(p + 8, message);
    store64(p + 16, packages);
    store64(p + 24, source);
    return p;
}

# =========================================================================
# ArkConfig
# Fields: default_strategy(0) confirm_system_installs(8) confirm_removals(16)
#         auto_update_check(24) color_output(32) marketplace_dir(40)
#         cache_dir(48) package_db_path(56) transaction_log_path(64)
#         shakti_path(72) apply(80) trust_keys(88) require_signed(96)
#         system_backend(104) apt_wrapper(112) native_root(120) => 128 bytes
#
# shakti_path: setuid privilege-escalation binary the executor invokes for
#   privileged steps (see docs/adr/0001-shakti-execution-backend.md).
# apply: 0 = plan only (default — safe); 1 = run the plan via the executor.
# trust_keys / require_signed: `.ark` signature trust anchor + fail-closed gate.
# system_backend: SOURCE_SYSTEM resolution+execution mode (ADR 0002) —
#   BACKEND_APT (default) / BACKEND_APT_AGNOS / BACKEND_NATIVE.
# apt_wrapper: command apt-get is fronted by in BACKEND_APT_AGNOS mode.
# =========================================================================

var ACFG_SZ = 128;

fn acfg_strategy(p) { return load64(p); }
fn acfg_confirm_sys(p) { return load64(p + 8); }
fn acfg_confirm_rm(p) { return load64(p + 16); }
fn acfg_auto_update(p) { return load64(p + 24); }
fn acfg_color(p) { return load64(p + 32); }
fn acfg_set_color(p, v) { store64(p + 32, v); }
fn acfg_mkt_dir(p) { return load64(p + 40); }
fn acfg_cache_dir(p) { return load64(p + 48); }
fn acfg_db_path(p) { return load64(p + 56); }
fn acfg_log_path(p) { return load64(p + 64); }
fn acfg_shakti_path(p) { return load64(p + 72); }
fn acfg_set_shakti_path(p, v) { store64(p + 72, v); }
fn acfg_apply(p) { return load64(p + 80); }
fn acfg_set_apply(p, v) { store64(p + 80, v); }
# Trust anchor for `.ark` signatures: file of trusted hex Ed25519 pubkeys.
fn acfg_trust_keys(p) { return load64(p + 88); }
fn acfg_set_trust_keys(p, v) { store64(p + 88, v); }
# Policy: 1 = refuse installs unless the signer is in the trust set (fail closed).
fn acfg_require_signed(p) { return load64(p + 96); }
fn acfg_set_require_signed(p, v) { store64(p + 96, v); }
# System backend mode (ADR 0002): BACKEND_APT / BACKEND_APT_AGNOS / BACKEND_NATIVE.
fn acfg_system_backend(p) { return load64(p + 104); }
fn acfg_set_system_backend(p, v) { store64(p + 104, v); }
# Wrapper command apt-get is fronted by when system_backend == BACKEND_APT_AGNOS.
fn acfg_apt_wrapper(p) { return load64(p + 112); }
fn acfg_set_apt_wrapper(p, v) { store64(p + 112, v); }
# Staging root the executor materializes native/marketplace `.ark` installs
# under during --apply ("" = real root). Mirrors the CLI `--root` for the
# resolved-plan path so privileged installs are testable off-root.
fn acfg_native_root(p) { return load64(p + 120); }
fn acfg_set_native_root(p, v) { store64(p + 120, v); }

# apply modes (acfg_apply): how the executor treats a built plan.
enum ApplyMode {
    APPLY_NONE = 0;   # show the plan only — default, runs nothing
    APPLY_REAL = 1;   # execute via shakti/system
    APPLY_DRY = 2;    # dry run — render concrete commands, run nothing
}

fn ark_config_default() {
    var p = alloc(ACFG_SZ);
    store64(p, STRAT_SYSTEM_FIRST);
    store64(p + 8, 1);
    store64(p + 16, 1);
    store64(p + 24, 0);
    store64(p + 32, 1);
    store64(p + 40, str_from("/var/lib/agnos/marketplace"));
    store64(p + 48, str_from("/var/cache/agnos/ark"));
    store64(p + 56, str_from(DEFAULT_PACKAGE_DB_PATH));
    store64(p + 64, str_from(DEFAULT_TRANSACTION_LOG_PATH));
    store64(p + 72, str_from(DEFAULT_SHAKTI_PATH));
    store64(p + 80, 0);
    store64(p + 88, str_from(DEFAULT_TRUST_KEYS_PATH));
    store64(p + 96, 0);
    # Default system backend per host (ADR 0002): AGNOS has no apt, so the
    # native backend (ark's `.ark` store + PackageDb) is the default there;
    # Debian/dev/CI defaults to apt so existing flows are byte-identical. The
    # nous SOURCE_NATIVE resolver + signed index/lockfile are the remaining
    # producer gate (nous-side); ark is the consumer and is wired and ready.
    #ifdef CYRIUS_TARGET_AGNOS
    store64(p + 104, BACKEND_NATIVE);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    store64(p + 104, BACKEND_APT);
    #endif
    store64(p + 112, str_from(DEFAULT_APT_WRAPPER));
    store64(p + 120, str_from(""));
    return p;
}
