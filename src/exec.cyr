# =========================================================================
# exec.cyr — Execution backend: plan -> shakti -> system
#
# Lowers each InstallStep of an InstallPlan to a concrete system command
# (a vec of Str argv elements). Privileged steps are wrapped with the
# setuid shakti binary: `shakti -- <argv...>`. shakti authenticates the
# caller, authorizes against /etc/agnos/sudoers.toml, execs the command,
# and propagates the child's exit code — which exec_vec_str returns.
#
# Design + rationale: docs/adr/0001-shakti-execution-backend.md
#
# Bite 1 wires the system source (apt-get via shakti). Marketplace
# (takumi) and Flutter (agpkg) lowering land in later bites; until then
# step_to_argv returns 0 for them and the executor refuses to run them
# rather than silently skipping.
# =========================================================================

# Current user, for transaction attribution. Falls back to euid==0 -> root.
fn exec_current_user() {
    var u = getenv("USER");
    if (u != 0) { return str_from(u); }
    if (sys_geteuid() == 0) { return str_from("root"); }
    return str_from("unknown");
}

# True (1) when a step mutates system state and must run with privilege.
fn step_needs_root(step) {
    var tag = istep_tag(step);
    if (tag == STEP_SYSTEM_INSTALL) { return 1; }
    if (tag == STEP_SYSTEM_REMOVE) { return 1; }
    if (tag == STEP_SYSTEM_UPDATE) { return 1; }
    return 0;
}

# Transaction op type for a step (install vs remove).
fn step_op_type(step) {
    var tag = istep_tag(step);
    if (tag == STEP_SYSTEM_REMOVE) { return OP_REMOVE; }
    if (tag == STEP_MARKETPLACE_REMOVE) { return OP_REMOVE; }
    if (tag == STEP_FLUTTER_REMOVE) { return OP_REMOVE; }
    return OP_INSTALL;
}

# Package source for a step, for transaction records.
fn step_source(step) {
    var tag = istep_tag(step);
    if (tag == STEP_MARKETPLACE_INSTALL) { return SOURCE_MARKETPLACE; }
    if (tag == STEP_MARKETPLACE_REMOVE) { return SOURCE_MARKETPLACE; }
    if (tag == STEP_FLUTTER_INSTALL) { return SOURCE_FLUTTER_APP; }
    if (tag == STEP_FLUTTER_REMOVE) { return SOURCE_FLUTTER_APP; }
    return SOURCE_SYSTEM;
}

# Lower a step to the *underlying* system command argv (no shakti prefix).
# Returns a vec of Str, or 0 if the step's backend is not yet wired.
fn step_to_argv(step) {
    var tag = istep_tag(step);
    var pkg = istep_pkg(step);
    var ver = istep_ver(step);
    var argv = vec_new();
    if (tag == STEP_SYSTEM_INSTALL) {
        vec_push(argv, str_from("apt-get"));
        vec_push(argv, str_from("install"));
        vec_push(argv, str_from("-y"));
        # apt accepts pkg=ver for an exact version pin
        if (ver != 0 && str_len(ver) > 0) {
            var sb = str_builder_new();
            str_builder_add(sb, pkg);
            str_builder_add_cstr(sb, "=");
            str_builder_add(sb, ver);
            vec_push(argv, str_builder_build(sb));
        } else {
            vec_push(argv, pkg);
        }
        return argv;
    }
    if (tag == STEP_SYSTEM_REMOVE) {
        vec_push(argv, str_from("apt-get"));
        if (istep_purge(step) == 1) { vec_push(argv, str_from("purge")); }
        else { vec_push(argv, str_from("remove")); }
        vec_push(argv, str_from("-y"));
        vec_push(argv, pkg);
        return argv;
    }
    if (tag == STEP_SYSTEM_UPDATE) {
        vec_push(argv, str_from("apt-get"));
        vec_push(argv, str_from("update"));
        return argv;
    }
    # marketplace (takumi) / flutter (agpkg): not yet wired
    return 0;
}

# Prepend the shakti escalation prefix when a step needs privilege.
# argv -> [shakti_path, "--", argv...].
fn exec_wrap_argv(argv, needs_root, shakti_path) {
    if (needs_root == 0) { return argv; }
    var w = vec_new();
    vec_push(w, shakti_path);
    vec_push(w, str_from("--"));
    var i = 0;
    while (i < vec_len(argv)) {
        vec_push(w, vec_get(argv, i));
        i = i + 1;
    }
    return w;
}

# Render an argv vec as a space-joined display string.
fn exec_argv_to_str(argv) {
    return str_join(argv, str_from(" "));
}

# Execute (or, when dry_run==1, describe) an InstallPlan.
# Returns an ArkResult: success(1)/message, or failure(0)/message on the
# first non-zero step. On a real run, each step is recorded to the
# transaction log; the transaction is committed on success or failed on
# the first error so rollback can later reverse it.
fn exec_plan(mgr, iplan, dry_run) {
    var steps = iplan_steps(iplan);
    var n = vec_len(steps);
    var affected = vec_new();
    if (n == 0) {
        return ark_result_new(1, str_from("Nothing to do (empty plan)"), affected, SOURCE_UNKNOWN);
    }

    var config = amgr_config(mgr);
    var shakti_path = acfg_shakti_path(config);
    var log = amgr_log(mgr);

    var sb = str_builder_new();
    if (dry_run == 1) {
        str_builder_add_cstr(sb, "Dry run — would execute ");
        str_builder_add_int(sb, n);
        str_builder_add_cstr(sb, " step(s):\n");
    }

    var tid = 0;
    if (dry_run == 0) { tid = txn_log_begin(log, exec_current_user()); }

    var i = 0;
    while (i < n) {
        var step = vec_get(steps, i);
        var pkg = istep_pkg(step);
        var argv = step_to_argv(step);
        if (argv == 0) {
            var msg = str_builder_new();
            str_builder_add_cstr(msg, "step backend not yet wired for '");
            str_builder_add(msg, pkg);
            str_builder_add_cstr(msg, "' (marketplace/flutter execution pending)");
            var emsg = str_builder_build(msg);
            if (dry_run == 0) { txn_log_fail(log, tid, emsg); }
            return ark_result_new(0, emsg, affected, step_source(step));
        }
        var full = exec_wrap_argv(argv, step_needs_root(step), shakti_path);

        if (dry_run == 1) {
            str_builder_add_cstr(sb, "  ");
            str_builder_add(sb, exec_argv_to_str(full));
            str_builder_add_cstr(sb, "\n");
            vec_push(affected, pkg);
        } else {
            var op = txn_op_new(step_op_type(step), pkg, istep_ver(step), step_source(step));
            txn_log_add_op(log, tid, op);
            var rc = exec_vec_str(full);
            if (rc == 0) {
                txn_log_mark_op_complete(log, tid, pkg);
                vec_push(affected, pkg);
            } else {
                var em = str_builder_new();
                str_builder_add_cstr(em, "command failed (exit ");
                str_builder_add_int(em, rc);
                str_builder_add_cstr(em, "): ");
                str_builder_add(em, exec_argv_to_str(full));
                var efail = str_builder_build(em);
                txn_log_mark_op_failed(log, tid, pkg, efail);
                txn_log_fail(log, tid, efail);
                return ark_result_new(0, efail, affected, step_source(step));
            }
        }
        i = i + 1;
    }

    if (dry_run == 0) {
        txn_log_commit(log, tid);
        str_builder_add_cstr(sb, "Executed ");
        str_builder_add_int(sb, n);
        str_builder_add_cstr(sb, " step(s) successfully");
    }
    return ark_result_new(1, str_builder_build(sb), affected, SOURCE_UNKNOWN);
}
