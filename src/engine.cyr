# =========================================================================
# NousResolver integration (nous 1.1.1 — multi-module)
# =========================================================================

var ZUGOT_PATH = "/usr/share/zugot";

fn nous_resolver_new(mkt_dir, cache_dir) {
    var rr = resolver_new(mkt_dir, cache_dir);
    if (is_err_result(rr)) { return 0; }
    var r = payload(rr);
    # Attach recipe DB for dependency fallback
    var rdb = recipe_db_load(str_from(ZUGOT_PATH));
    if (rdb > 0) { resolver_with_recipes(r, rdb); }
    return r;
}

fn nous_resolve(r, name) {
    if (r == 0) { return 0; }
    var rr = resolver_resolve(r, name);
    if (is_err_result(rr)) {
        # Try suggestion on invalid/not-found
        var err = payload(rr);
        if (ne_kind(err) == ERR_INVALID_PACKAGE_NAME) {
            var known = collect_known_names(r);
            var sug = suggest_package(ne_msg(err), known);
            if (sug > 0) {
                var msg = build_suggestion(ne_msg(err), sug);
                print(str_data(msg), str_len(msg));
                print("\n", 1);
            }
        }
        return 0;
    }
    return payload(rr);
}

fn nous_resolve_all(r, names) {
    if (r == 0) { return Err(1); }
    return resolver_resolve_all_with_recipes(r, names);
}

fn nous_search(r, query) {
    if (r == 0) { return vec_new(); }
    var rr = resolver_search(r, query);
    if (is_err_result(rr)) { return vec_new(); }
    var sr = payload(rr);
    return sr_results(sr);
}

fn nous_list_installed(r) {
    if (r == 0) { return vec_new(); }
    var rr = resolver_list(r);
    if (is_err_result(rr)) { return vec_new(); }
    return payload(rr);
}

# Multi-source update detection (1.1.3) — apt via nous's sysdb, plus marketplace/
# community updates by handing nous (resolver_check_updates) the installed set
# from ark's PackageDb and an avail_fn that resolves each package's latest
# version from the configured marketplace (mela's /latest). With no marketplace
# URL configured, avail_fn is nil and detection stays apt-only. Returns a vec of
# nous avail_update records (read with nupd_*).
# Build the installed set ark hands to nous's detector: its authoritative
# marketplace/community packages from PackageDb, as nous installed_pkg records.
# Held packages are skipped — they won't upgrade, so there's no reason to query
# the marketplace about them (avoids a wasted /latest round-trip and doesn't
# leak held-package names to the server).
fn ark_installed_for_updates(mgr) {
    var installed = vec_new();
    var db = amgr_db(mgr);
    var entries = pkg_db_list(db);
    var i = 0;
    while (i < vec_len(entries)) {
        var e = vec_get(entries, i);
        var src = pdbe_source(e);
        if (src == SOURCE_MARKETPLACE || src == SOURCE_COMMUNITY) {
            if (pkg_db_is_held(db, pdbe_name(e)) == 0) {
                vec_push(installed, installed_pkg_new(pdbe_name(e), pdbe_version(e), src, 0, pdbe_size(e), 0));
            }
        }
        i = i + 1;
    }
    return installed;
}

fn ark_check_updates(mgr) {
    var r = amgr_resolver(mgr);
    if (r == 0) { return vec_new(); }
    var cfg = amgr_config(mgr);
    var installed = ark_installed_for_updates(mgr);

    # Hand the marketplace URL to the avail_fn via its global (the fncall2 seam
    # only carries name+source); nil URL → apt-only detection.
    var url = acfg_marketplace_url(cfg);
    ARK_AVAIL_MKT_URL = 0;
    var avail_fn = 0;
    if (url != 0) {
        if (str_len(url) > 0) {
            ARK_AVAIL_MKT_URL = url;
            avail_fn = &ark_avail_lookup;
        }
    }

    var rr = resolver_check_updates(r, installed, avail_fn);
    if (is_err_result(rr)) { return vec_new(); }
    return payload(rr);
}

# =========================================================================
# Group meta-package mappings
# =========================================================================

# Validate package name: [a-zA-Z0-9][a-zA-Z0-9._-]*, max 128 chars
fn validate_pkg_name(name) {
    var d = str_data(name);
    var n = str_len(name);
    if (n == 0 || n > 128) { return 0; }
    # First char must be alphanumeric
    var c = load8(d);
    if (c < 48) { return 0; }
    if (c > 57 && c < 65) { return 0; }
    if (c > 90 && c < 97) { return 0; }
    if (c > 122) { return 0; }
    var i = 1;
    while (i < n) {
        c = load8(d + i);
        # Allow: 0-9 A-Z a-z . _ -
        if (c == 46 || c == 95 || c == 45) { i = i + 1; }
        elif (c >= 48 && c <= 57) { i = i + 1; }
        elif (c >= 65 && c <= 90) { i = i + 1; }
        elif (c >= 97 && c <= 122) { i = i + 1; }
        else { return 0; }
    }
    # Reject path traversal
    if (str_contains(name, str_from(".."))) { return 0; }
    if (str_contains(name, str_from("/"))) { return 0; }
    return 1;
}

# =========================================================================
# Group meta-package mappings
# =========================================================================

fn group_meta_package(group) {
    if (streq(group, "desktop")) { return "agnos-desktop"; }
    if (streq(group, "ai")) { return "agnos-ai"; }
    if (streq(group, "ml")) { return "agnos-ai"; }
    if (streq(group, "shell")) { return "agnoshi"; }
    if (streq(group, "edge")) { return "agnos-edge-agent"; }
    if (streq(group, "iot")) { return "agnos-edge-agent"; }
    return 0;
}

# =========================================================================
# ArkPackageManager
# Fields: config(0) resolver(8) package_db(16) transaction_log(24) => 32 bytes
# =========================================================================

var AMGR_SZ = 32;

fn amgr_config(p) { return load64(p); }
fn amgr_resolver(p) { return load64(p + 8); }
fn amgr_db(p) { return load64(p + 16); }
fn amgr_log(p) { return load64(p + 24); }

fn ark_mgr_new(config) {
    var p = alloc(AMGR_SZ);
    store64(p, config);
    var r = nous_resolver_new(acfg_mkt_dir(config), acfg_cache_dir(config));
    if (r != 0) {
        var strat = strategy_new(acfg_strategy(config), 0);
        resolver_with_strategy(r, strat);
    }
    store64(p + 8, r);
    store64(p + 16, pkg_db_load(acfg_db_path(config)));
    store64(p + 24, txn_log_load(acfg_log_path(config)));
    return p;
}

# =========================================================================
# ArkPackageManager methods
# =========================================================================

# --dir batch install: install every `.ark` file in `dir_str` into the (optional)
# install root, accumulating records into the target's PackageDb. This is the
# call agnova makes to install a directory of pre-staged base `.ark` packages in
# one shot. Non-`.ark` entries are skipped. Each package goes through the proven
# single-`.ark` path (ark_install_local → ark_pkg_install), so files stage into
# --root and the record lands in --root's DB (the config db/log paths were already
# root-prefixed at the cli.cyr dispatch). Fails closed: any single failure makes
# the batch result a failure (with a count), so agnova sees a non-zero exit.
fn ark_install_dir(mgr, dir_str, root_str) {
    var entries = dir_list(dir_str);
    var installed = 0;
    var failed = 0;
    var last_err = str_from("");
    var i = 0;
    while (i < vec_len(entries)) {
        var name = vec_get(entries, i);
        # apkg_is_ark_path takes a Str (str_ends_with wants Str, Str) — pass the
        # dir_list entry Str directly, NOT str_data(name) (a cstring read as a Str
        # header faults).
        if (apkg_is_ark_path(name) == 1) {
            var sb = str_builder_new();
            str_builder_add(sb, dir_str);
            str_builder_add_cstr(sb, "/");
            str_builder_add(sb, name);
            var r = ark_install_local(mgr, str_builder_build(sb), root_str);
            if (ares_success(r) == 1) { installed = installed + 1; }
            else { failed = failed + 1; last_err = ares_message(r); }
        }
        i = i + 1;
    }
    if (installed == 0) { if (failed == 0) {
            var sbn = str_builder_new();
            str_builder_add_cstr(sbn, "ark: --dir: no .ark packages found in ");
            str_builder_add(sbn, dir_str);
            return ark_result_new(0, str_builder_build(sbn), vec_new(), SOURCE_UNKNOWN);
        } }
    if (failed > 0) {
        var sbf = str_builder_new();
        str_builder_add_cstr(sbf, "ark: --dir install: ");
        str_builder_add_int(sbf, failed);
        str_builder_add_cstr(sbf, " of ");
        str_builder_add_int(sbf, installed + failed);
        str_builder_add_cstr(sbf, " failed (last: ");
        str_builder_add(sbf, last_err);
        str_builder_add_cstr(sbf, ")");
        return ark_result_new(0, str_builder_build(sbf), vec_new(), SOURCE_UNKNOWN);
    }
    var sbok = str_builder_new();
    str_builder_add_cstr(sbok, "Installed ");
    str_builder_add_int(sbok, installed);
    str_builder_add_cstr(sbok, " package(s) from ");
    str_builder_add(sbok, dir_str);
    return ark_result_new(1, str_builder_build(sbok), vec_new(), SOURCE_UNKNOWN);
}

# Wire a command's --root into config.native_root so the name/group install
# paths stage their files into the target root. exec_native_step reads
# config.native_root as the staging root, and NOTHING else sets it — so without
# this a `ark install --root <dir> <name>` would resolve+install into the LIVE
# root, not <dir>. The single-.ark and marketplace branches pass their install
# root explicitly to ark_install_local / ark_marketplace_install_arg and do not
# read native_root, so they neither need nor are affected by this.
fn _apply_native_root(mgr, cmd) {
    var r = acmd_root(cmd);
    if (r != 0) { if (str_len(r) > 0) { acfg_set_native_root(amgr_config(mgr), r); } }
    return 0;
}

fn ark_execute(mgr, cmd) {
    var tag = acmd_tag(cmd);
    if (tag == CMD_INSTALL) {
        var ipkgs = acmd_packages(cmd);
        # `--dir <pkgdir>`: batch-install every .ark in the directory into --root
        # (agnova's base-system path — one call, no package names).
        if (str_len(acmd_dir(cmd)) > 0) {
            return ark_install_dir(mgr, acmd_dir(cmd), acmd_root(cmd));
        }
        # `--marketplace URL` + name@version: download from mela, then install.
        if (str_len(acmd_mkt_url(cmd)) > 0) {
            if (vec_len(ipkgs) == 1) {
                return ark_marketplace_install_arg(mgr, acmd_mkt_url(cmd),
                vec_get(ipkgs, 0), acmd_root(cmd));
            }
        }
        # A single `.ark` path argument is a direct local install.
        if (vec_len(ipkgs) == 1) {
            if (apkg_is_ark_path(vec_get(ipkgs, 0)) == 1) {
                return ark_install_local(mgr, vec_get(ipkgs, 0), acmd_root(cmd));
            }
        }
        _apply_native_root(mgr, cmd);
        return ark_install(mgr, ipkgs, acmd_force(cmd));
    }
    if (tag == CMD_GROUP_INSTALL) {
        var meta = group_meta_package(str_data(acmd_group(cmd)));
        if (meta == 0) { meta = str_data(acmd_group(cmd)); }
        var pkgs = vec_new();
        vec_push(pkgs, str_from(meta));
        _apply_native_root(mgr, cmd);
        return ark_install(mgr, pkgs, acmd_force(cmd));
    }
    if (tag == CMD_REMOVE) { return ark_remove(mgr, acmd_packages(cmd), acmd_purge(cmd)); }
    if (tag == CMD_SEARCH) {
        var out = ark_search(mgr, acmd_query(cmd), acmd_source(cmd));
        return ark_result_new(1, ark_output_to_display_string(out), vec_new(), SOURCE_UNKNOWN);
    }
    if (tag == CMD_LIST) {
        var out = ark_list(mgr, acmd_source(cmd));
        return ark_result_new(1, ark_output_to_display_string(out), vec_new(), SOURCE_UNKNOWN);
    }
    if (tag == CMD_INFO) {
        var out = ark_info(mgr, acmd_package(cmd));
        var pkgs = vec_new(); vec_push(pkgs, acmd_package(cmd));
        return ark_result_new(1, ark_output_to_display_string(out), pkgs, SOURCE_UNKNOWN);
    }
    if (tag == CMD_UPDATE) {
        var out = ark_update(mgr);
        return ark_result_new(1, ark_output_to_display_string(out), vec_new(), SOURCE_UNKNOWN);
    }
    if (tag == CMD_UPGRADE) { return ark_upgrade(mgr, acmd_packages(cmd)); }
    if (tag == CMD_STATUS) {
        var out = ark_status(mgr);
        return ark_result_new(1, ark_output_to_display_string(out), vec_new(), SOURCE_UNKNOWN);
    }
    if (tag == CMD_HOLD) { return ark_hold(mgr, acmd_packages(cmd)); }
    if (tag == CMD_UNHOLD) { return ark_unhold(mgr, acmd_packages(cmd)); }
    if (tag == CMD_VERIFY) {
        var out = ark_verify(mgr, acmd_package(cmd));
        return ark_result_new(1, ark_output_to_display_string(out), vec_new(), SOURCE_UNKNOWN);
    }
    if (tag == CMD_HISTORY) {
        var out = ark_history(mgr, acmd_count(cmd));
        return ark_result_new(1, ark_output_to_display_string(out), vec_new(), SOURCE_UNKNOWN);
    }
    if (tag == CMD_PIN) { return ark_pin(mgr, acmd_packages(cmd), acmd_force(cmd)); }
    if (tag == CMD_UNPIN) { return ark_unpin(mgr, acmd_packages(cmd)); }
    if (tag == CMD_ROLLBACK) { return ark_rollback(mgr, acmd_package(cmd)); }
    if (tag == CMD_BACKUP) { return ark_backup(mgr); }
    if (tag == CMD_RESTORE) { return ark_restore(mgr, acmd_package(cmd)); }
    if (tag == CMD_BAZAAR) { return ark_bazaar(mgr, acmd_group(cmd), acmd_query(cmd)); }
    return ark_result_new(0, str_from("Unknown command"), vec_new(), SOURCE_UNKNOWN);
}

fn ark_pin(mgr, packages, pin_source) {
    var affected = vec_new();
    var i = 0;
    while (i < vec_len(packages)) {
        var name = vec_get(packages, i);
        if (pin_source) {
            if (pkg_db_pin_source(amgr_db(mgr), name)) { vec_push(affected, name); }
        } else {
            if (pkg_db_pin_version(amgr_db(mgr), name)) { vec_push(affected, name); }
        }
        i = i + 1;
    }
    pkg_db_save(amgr_db(mgr));
    var sb = str_builder_new();
    str_builder_add_int(sb, vec_len(affected));
    if (pin_source) { str_builder_add_cstr(sb, " package(s) source-pinned"); }
    else { str_builder_add_cstr(sb, " package(s) version-pinned"); }
    return ark_result_new(1, str_builder_build(sb), affected, SOURCE_UNKNOWN);
}

fn ark_unpin(mgr, packages) {
    var affected = vec_new();
    var i = 0;
    while (i < vec_len(packages)) {
        var name = vec_get(packages, i);
        pkg_db_unpin_version(amgr_db(mgr), name);
        pkg_db_unpin_source(amgr_db(mgr), name);
        vec_push(affected, name);
        i = i + 1;
    }
    pkg_db_save(amgr_db(mgr));
    var sb = str_builder_new();
    str_builder_add_int(sb, vec_len(affected));
    str_builder_add_cstr(sb, " package(s) unpinned");
    return ark_result_new(1, str_builder_build(sb), affected, SOURCE_UNKNOWN);
}

# Rollback: generate a reverse plan from a transaction.
# If txn_id is empty, rolls back the most recent committed transaction.
fn ark_rollback(mgr, txn_id_str) {
    var log = amgr_log(mgr);
    var txn = 0;
    if (str_len(txn_id_str) > 0) {
        txn = txn_log_get(log, txn_id_str);
    } else {
        # Find most recent committed
        var recent = txn_log_recent(log, 20);
        var i = 0;
        while (i < vec_len(recent)) {
            var t = vec_get(recent, i);
            if (txn_status(t) == TXN_COMMITTED) { txn = t; break; }
            i = i + 1;
        }
    }
    if (txn == 0) {
        return ark_result_new(0, str_from("No transaction found to rollback"), vec_new(), SOURCE_UNKNOWN);
    }
    if (txn_status(txn) != TXN_COMMITTED) {
        return ark_result_new(0, str_from("Transaction is not committed"), vec_new(), SOURCE_UNKNOWN);
    }
    # Build reverse plan
    var plan = install_plan_new();
    var ops = txn_ops(txn);
    var affected = vec_new();
    var i = vec_len(ops) - 1;
    while (i >= 0) {
        var op = vec_get(ops, i);
        var ot = top_type(op);
        var pkg = top_pkg(op);
        # Reverse with the SAME source as the original op, so each source rolls
        # back through its own backend (marketplace/community via the native
        # remover, flutter via agpkg, system via apt/native) — never silently
        # misrouted to apt.
        var osrc = top_source(op);
        var mkt = (osrc == SOURCE_MARKETPLACE || osrc == SOURCE_COMMUNITY);
        var flutter = (osrc == SOURCE_FLUTTER_APP);
        if (ot == OP_INSTALL) {
            if (mkt == 1) { vec_push(iplan_steps(plan), step_marketplace_remove(pkg)); }
            elif (flutter == 1) { vec_push(iplan_steps(plan), step_flutter_remove(pkg)); }
            else { vec_push(iplan_steps(plan), step_system_remove(pkg, 0)); }
            vec_push(affected, pkg);
        }
        if (ot == OP_REMOVE) {
            if (mkt == 1) { vec_push(iplan_steps(plan), step_marketplace_install(pkg, top_ver(op))); }
            elif (flutter == 1) { vec_push(iplan_steps(plan), step_flutter_install(pkg, top_ver(op))); }
            else { vec_push(iplan_steps(plan), step_system_install(pkg, top_ver(op))); }
            vec_push(affected, pkg);
        }
        if (i == 0) { break; }
        i = i - 1;
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Rollback plan for ");
    str_builder_add(sb, txn_id(txn));
    str_builder_add_cstr(sb, ": ");
    str_builder_add_int(sb, vec_len(iplan_steps(plan)));
    str_builder_add_cstr(sb, " reverse step(s)");
    var described = ark_result_new(1, str_builder_build(sb), affected, SOURCE_UNKNOWN);
    return ark_apply_or_describe(mgr, plan, described);
}

# Backup: copy packages.json and transaction.log to a timestamped dir
fn ark_backup(mgr) {
    var cfg = amgr_config(mgr);
    var ts = ark_now_secs();
    var sb = str_builder_new();
    str_builder_add(sb, acfg_cache_dir(cfg));
    str_builder_add_cstr(sb, "/backup-");
    str_builder_add_int(sb, ts);
    var backup_dir = str_builder_build(sb);
    sys_mkdir(str_data(backup_dir), 448);
    # Copy package DB
    var db_src = acfg_db_path(cfg);
    var db_dst_sb = str_builder_new();
    str_builder_add(db_dst_sb, backup_dir);
    str_builder_add_cstr(db_dst_sb, "/packages.json");
    var db_dst = str_builder_build(db_dst_sb);
    var buf = alloc(65536);
    var n = file_read_all(str_data(db_src), buf, 524288);
    if (n > 0) { file_write_all(str_data(db_dst), buf, n); }
    # Copy transaction log
    var log_src = acfg_log_path(cfg);
    var log_dst_sb = str_builder_new();
    str_builder_add(log_dst_sb, backup_dir);
    str_builder_add_cstr(log_dst_sb, "/transaction.log");
    var log_dst = str_builder_build(log_dst_sb);
    n = file_read_all(str_data(log_src), buf, 524288);
    if (n > 0) { file_write_all(str_data(log_dst), buf, n); }
    var msg_sb = str_builder_new();
    str_builder_add_cstr(msg_sb, "Backup created: ");
    str_builder_add(msg_sb, backup_dir);
    return ark_result_new(1, str_builder_build(msg_sb), vec_new(), SOURCE_UNKNOWN);
}

# Restore: copy backup files back to active paths
fn ark_restore(mgr, backup_path) {
    var cfg = amgr_config(mgr);
    var buf = alloc(65536);
    # Restore package DB
    var db_src_sb = str_builder_new();
    str_builder_add(db_src_sb, backup_path);
    str_builder_add_cstr(db_src_sb, "/packages.json");
    var n = file_read_all(str_data(str_builder_build(db_src_sb)), buf, 524288);
    if (n > 0) { file_write_all(str_data(acfg_db_path(cfg)), buf, n); }
    # Restore transaction log
    var log_src_sb = str_builder_new();
    str_builder_add(log_src_sb, backup_path);
    str_builder_add_cstr(log_src_sb, "/transaction.log");
    n = file_read_all(str_data(str_builder_build(log_src_sb)), buf, 524288);
    if (n > 0) { file_write_all(str_data(acfg_log_path(cfg)), buf, n); }
    var msg_sb = str_builder_new();
    str_builder_add_cstr(msg_sb, "Restored from: ");
    str_builder_add(msg_sb, backup_path);
    return ark_result_new(1, str_builder_build(msg_sb), vec_new(), SOURCE_UNKNOWN);
}

fn ark_install(mgr, packages, force) {
    if (vec_len(packages) == 0) {
        return ark_result_new(0, str_from("No packages specified"), vec_new(), SOURCE_UNKNOWN);
    }
    var r = amgr_resolver(mgr);

    # Graph-based transitive resolution (nous 1.1.1)
    var result = nous_resolve_all(r, packages);
    if (is_err_result(result)) {
        var err = payload(result);
        var kind = ne_kind(err);
        var msg = nous_error_msg(err);
        # Suggest closest match for unknown packages
        if (kind == ERR_INVALID_PACKAGE_NAME) {
            var known = collect_known_names(r);
            var sug = suggest_package(ne_msg(err), known);
            if (sug > 0) { msg = build_suggestion(ne_msg(err), sug); }
        }
        return ark_result_new(0, msg, vec_new(), SOURCE_UNKNOWN);
    }

    var plan = payload(result);
    var pkgs = pl_packages(plan);
    var order = pl_order(plan);
    var affected = vec_new();

    # Build install steps from resolved packages in dep order
    var iplan = install_plan_new();
    var i = 0;
    while (i < vec_len(pkgs)) {
        var pkg = vec_get(pkgs, i);
        var src = rp_src(pkg);
        var name = rp_name(pkg);
        var ver = rp_ver(pkg);
        vec_push(affected, name);
        if (src == SOURCE_SYSTEM) {
            vec_push(iplan_steps(iplan), step_system_install(name, ver));
            iplan_set_root(iplan, 1);
        } elif (src == SOURCE_MARKETPLACE || src == SOURCE_COMMUNITY) {
            vec_push(iplan_steps(iplan), step_marketplace_install(name, ver));
        } elif (src == SOURCE_FLUTTER_APP) {
            vec_push(iplan_steps(iplan), step_flutter_install(name, ver));
        }
        i = i + 1;
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Install plan (");
    str_builder_add_int(sb, vec_len(affected));
    str_builder_add_cstr(sb, " packages, deps-first): ");
    str_builder_add(sb, str_join(order, str_from(", ")));
    var primary = SOURCE_UNKNOWN;
    if (vec_len(pkgs) > 0) { primary = rp_src(vec_get(pkgs, 0)); }
    var described = ark_result_new(1, str_builder_build(sb), affected, primary);
    return ark_apply_or_describe(mgr, iplan, described);
}

fn ark_remove(mgr, packages, purge) {
    if (vec_len(packages) == 0) {
        return ark_result_new(0, str_from("No packages specified"), vec_new(), SOURCE_UNKNOWN);
    }
    var plan = ark_plan_remove(mgr, packages, purge);
    var steps = iplan_steps(plan);
    var primary = SOURCE_UNKNOWN;
    if (vec_len(steps) > 0) {
        var first_tag = istep_tag(vec_get(steps, 0));
        if (first_tag == STEP_SYSTEM_REMOVE) { primary = SOURCE_SYSTEM; }
        if (first_tag == STEP_MARKETPLACE_REMOVE) { primary = SOURCE_MARKETPLACE; }
        if (first_tag == STEP_FLUTTER_REMOVE) { primary = SOURCE_FLUTTER_APP; }
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Remove plan (");
    str_builder_add_int(sb, vec_len(steps));
    str_builder_add_cstr(sb, " steps)");
    var described = ark_result_new(1, str_builder_build(sb), packages, primary);
    return ark_apply_or_describe(mgr, plan, described);
}

fn ark_search(mgr, query, source_filter) {
    var output = ark_output_new();
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Search: ");
    str_builder_add(sb, query);
    ark_output_add(output, output_line_header(str_builder_build(sb)));
    var results = nous_search(amgr_resolver(mgr), query);
    if (vec_len(results) == 0) {
        ark_output_add(output, output_line_warning(str_from("No packages found")));
    }
    ark_output_add(output, output_line_separator());
    var csb = str_builder_new();
    str_builder_add_int(csb, vec_len(results));
    str_builder_add_cstr(csb, " result(s)");
    ark_output_add(output, output_line_info(str_from("Total"), str_builder_build(csb)));
    return output;
}

fn ark_list(mgr, source_filter) {
    var output = ark_output_new();
    if (source_filter >= 0) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "Installed packages [");
        str_builder_add_cstr(sb, source_to_str(source_filter));
        str_builder_add_cstr(sb, "]");
        ark_output_add(output, output_line_header(str_builder_build(sb)));
    } else {
        ark_output_add(output, output_line_header(str_from("Installed packages")));
    }
    var packages = nous_list_installed(amgr_resolver(mgr));
    if (vec_len(packages) == 0) {
        ark_output_add(output, output_line_warning(str_from("No packages installed")));
    }
    ark_output_add(output, output_line_separator());
    var csb = str_builder_new();
    str_builder_add_int(csb, vec_len(packages));
    str_builder_add_cstr(csb, " package(s)");
    ark_output_add(output, output_line_info(str_from("Total"), str_builder_build(csb)));
    return output;
}

fn ark_info(mgr, package) {
    var output = ark_output_new();
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Package: ");
    str_builder_add(sb, package);
    ark_output_add(output, output_line_header(str_builder_build(sb)));
    var resolved = nous_resolve(amgr_resolver(mgr), package);
    if (resolved == 0) {
        var wsb = str_builder_new();
        str_builder_add_cstr(wsb, "Package '");
        str_builder_add(wsb, package);
        str_builder_add_cstr(wsb, "' not found in any source");
        ark_output_add(output, output_line_warning(str_builder_build(wsb)));
    }
    return output;
}

fn ark_update(mgr) {
    var output = ark_output_new();
    ark_output_add(output, output_line_header(str_from("Update check")));
    var updates = ark_check_updates(mgr);
    if (vec_len(updates) == 0) {
        ark_output_add(output, output_line_success(str_from("All packages up to date")));
    }
    ark_output_add(output, output_line_separator());
    var sb = str_builder_new();
    str_builder_add_int(sb, vec_len(updates));
    ark_output_add(output, output_line_info(str_from("Updates available"), str_builder_build(sb)));
    return output;
}

# nous "update" object accessors — mirror nous's update struct layout (see
# update_to_json in nous): name(0) source(8) installed_version(16)
# available_version(24) changelog(32).
fn nupd_name(u) { return load64(u); }
fn nupd_source(u) { return load64(u + 8); }
fn nupd_installed(u) { return load64(u + 16); }
fn nupd_available(u) { return load64(u + 24); }

# True (1) when Str `name` equals any Str in `vec`.
fn name_in_vec(vec, name) {
    var i = 0;
    while (i < vec_len(vec)) {
        if (str_eq(vec_get(vec, i), name) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Build an upgrade InstallPlan from a list of nous updates: one install step per
# update at its available version, lowered by source (the system/native command
# is chosen backend-aware in exec.cyr). Held packages are skipped; when
# `packages` is non-empty, only those names are included.
fn ark_build_upgrade_plan(mgr, updates, packages) {
    var plan = install_plan_new();
    var steps = iplan_steps(plan);
    var db = amgr_db(mgr);
    var filter = (vec_len(packages) > 0);
    var i = 0;
    while (i < vec_len(updates)) {
        var u = vec_get(updates, i);
        var name = nupd_name(u);
        var av = nupd_available(u);
        var src = nupd_source(u);
        # Skip ark-managed packages that are held, or whose version/source pin
        # the upgrade would violate. (These gate ark-managed packages only —
        # apt/system packages aren't in PackageDb, so apt's own apt-mark governs
        # their holds; and enforcement across CLI processes is gated on the
        # PackageDb reload follow-up, see roadmap.)
        var skip = (pkg_db_is_held(db, name) == 1);
        if (skip == 0) {
            if (pkg_db_upgrade_allowed(db, name, av, src) == 0) { skip = 1; }
        }
        if (skip == 0) {
            var include = 1;
            if (filter == 1) { include = name_in_vec(packages, name); }
            if (include == 1) {
                if (src == SOURCE_MARKETPLACE || src == SOURCE_COMMUNITY) {
                    vec_push(steps, step_marketplace_install(name, av));
                } elif (src == SOURCE_FLUTTER_APP) {
                    vec_push(steps, step_flutter_install(name, av));
                } else {
                    vec_push(steps, step_system_install(name, av));
                    iplan_set_root(plan, 1);
                }
            }
        }
        i = i + 1;
    }
    return plan;
}

# Upgrade installed packages to their available versions. Real apply (M4 host
# slice): builds a backend-aware plan (apt-get pkg=ver, or the native `.ark`
# installer under BACKEND_NATIVE) and runs it through the executor — `--apply`
# upgrades in a rollback-able transaction, `--dry-run` shows the commands, and
# plan-only (default) just describes. Update detection comes from nous
# (apt-system today; native/marketplace detection is a nous producer gate).
fn ark_upgrade(mgr, packages) {
    var updates = ark_check_updates(mgr);
    var plan = ark_build_upgrade_plan(mgr, updates, packages);
    var steps = iplan_steps(plan);
    if (vec_len(steps) == 0) {
        return ark_result_new(1, str_from("Nothing to upgrade (up to date, held, or filtered out)"),
        vec_new(), SOURCE_UNKNOWN);
    }
    var affected = vec_new();
    var i = 0;
    while (i < vec_len(steps)) {
        vec_push(affected, istep_pkg(vec_get(steps, i)));
        i = i + 1;
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Upgrade plan: ");
    str_builder_add_int(sb, vec_len(steps));
    str_builder_add_cstr(sb, " package(s)");
    var described = ark_result_new(1, str_builder_build(sb), affected, SOURCE_UNKNOWN);
    return ark_apply_or_describe(mgr, plan, described);
}

fn ark_status(mgr) {
    var cfg = amgr_config(mgr);
    var output = ark_output_new();
    ark_output_add(output, output_line_header(str_from("ark status")));
    ark_output_add(output, output_line_info(str_from("Version"), str_from(ARK_VERSION_STR)));
    ark_output_add(output, output_line_info(str_from("Strategy"), str_from(strategy_to_str(acfg_strategy(cfg)))));
    ark_output_add(output, output_line_info(str_from("Marketplace dir"), acfg_mkt_dir(cfg)));
    ark_output_add(output, output_line_info(str_from("Cache dir"), acfg_cache_dir(cfg)));
    ark_output_add(output, output_line_separator());
    ark_output_add(output, output_line_info(str_from("Sources"), str_from("system (apt), marketplace, flutter")));
    ark_output_add(output, output_line_info(str_from("System packages"), str_from("0")));
    ark_output_add(output, output_line_info(str_from("Marketplace packages"), str_from("0")));
    ark_output_add(output, output_line_info(str_from("Flutter apps"), str_from("0")));
    ark_output_add(output, output_line_success(str_from("ark is operational")));
    return output;
}

fn ark_hold(mgr, packages) {
    var affected = vec_new();
    var i = 0;
    while (i < vec_len(packages)) {
        var name = vec_get(packages, i);
        if (pkg_db_hold(amgr_db(mgr), name)) { vec_push(affected, name); }
        i = i + 1;
    }
    pkg_db_save(amgr_db(mgr));
    var sb = str_builder_new();
    str_builder_add_int(sb, vec_len(affected));
    str_builder_add_cstr(sb, " package(s) held");
    return ark_result_new(1, str_builder_build(sb), affected, SOURCE_UNKNOWN);
}

fn ark_unhold(mgr, packages) {
    var affected = vec_new();
    var i = 0;
    while (i < vec_len(packages)) {
        var name = vec_get(packages, i);
        if (pkg_db_unhold(amgr_db(mgr), name)) { vec_push(affected, name); }
        i = i + 1;
    }
    pkg_db_save(amgr_db(mgr));
    var sb = str_builder_new();
    str_builder_add_int(sb, vec_len(affected));
    str_builder_add_cstr(sb, " package(s) unheld");
    return ark_result_new(1, str_builder_build(sb), affected, SOURCE_UNKNOWN);
}

fn ark_verify(mgr, package) {
    var issues = pkg_db_check_integrity_full(amgr_db(mgr), package);
    var output = ark_output_new();
    if (str_len(package) > 0) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "Integrity check: ");
        str_builder_add(sb, package);
        ark_output_add(output, output_line_header(str_builder_build(sb)));
    } else {
        ark_output_add(output, output_line_header(str_from("Integrity check: all packages")));
    }
    if (vec_len(issues) == 0) {
        ark_output_add(output, output_line_success(str_from("No integrity issues found")));
    } else {
        var i = 0;
        while (i < vec_len(issues)) {
            var issue = vec_get(issues, i);
            var sb = str_builder_new();
            str_builder_add(sb, iissue_name(issue));
            str_builder_add_cstr(sb, ": ");
            var it = iissue_type(issue);
            if (it == ISSUE_NO_MANIFEST) {
                str_builder_add_cstr(sb, "no file manifest");
            }
            if (it == ISSUE_MISSING_FILE) {
                str_builder_add_cstr(sb, "missing file: ");
                str_builder_add(sb, iissue_detail(issue));
            }
            if (it == ISSUE_CHECKSUM_MISMATCH) {
                str_builder_add_cstr(sb, "checksum mismatch: ");
                str_builder_add(sb, iissue_detail(issue));
            }
            ark_output_add(output, output_line_warning(str_builder_build(sb)));
            i = i + 1;
        }
    }
    ark_output_add(output, output_line_separator());
    var csb = str_builder_new();
    str_builder_add_int(csb, vec_len(issues));
    ark_output_add(output, output_line_info(str_from("Issues found"), str_builder_build(csb)));
    return output;
}

fn ark_history(mgr, count) {
    var n = 10;
    if (count >= 0) { n = count; }
    var recent = txn_log_recent(amgr_log(mgr), n);
    var output = ark_output_new();
    var hsb = str_builder_new();
    str_builder_add_cstr(hsb, "Transaction history (last ");
    str_builder_add_int(hsb, n);
    str_builder_add_cstr(hsb, ")");
    ark_output_add(output, output_line_header(str_builder_build(hsb)));
    if (vec_len(recent) == 0) {
        ark_output_add(output, output_line_warning(str_from("No transactions recorded")));
    } else {
        var i = 0;
        while (i < vec_len(recent)) {
            var t = vec_get(recent, i);
            var vsb = str_builder_new();
            str_builder_add(vsb, txn_status_to_str(txn_status(t), txn_errmsg(t)));
            str_builder_add_cstr(vsb, " | ");
            str_builder_add(vsb, txn_user(t));
            str_builder_add_cstr(vsb, " | ");
            str_builder_add_int(vsb, vec_len(txn_ops(t)));
            str_builder_add_cstr(vsb, " ops");
            ark_output_add(output, output_line_info(txn_id(t), str_builder_build(vsb)));
            i = i + 1;
        }
    }
    ark_output_add(output, output_line_separator());
    var tsb = str_builder_new();
    str_builder_add_int(tsb, txn_log_len(amgr_log(mgr)));
    ark_output_add(output, output_line_info(str_from("Total transactions"), str_builder_build(tsb)));
    return output;
}

fn ark_plan_remove(mgr, packages, purge) {
    var plan = install_plan_new();
    var steps = iplan_steps(plan);
    var r = amgr_resolver(mgr);
    var db = amgr_db(mgr);
    var i = 0;
    while (i < vec_len(packages)) {
        var name = vec_get(packages, i);
        # Carry the installed version on the remove step so a rollback-of-remove
        # reinstalls at the right version (apt lowering ignores the version).
        var ver = str_from("");
        var e = pkg_db_get(db, str_data(name));
        if (e != 0) { ver = pdbe_version(e); }
        if (r != 0 && resolver_is_mkt(r, name)) {
            vec_push(steps, step_new(STEP_MARKETPLACE_REMOVE, name, ver, 0));
        } else {
            vec_push(steps, step_new(STEP_SYSTEM_REMOVE, name, ver, purge));
            iplan_set_root(plan, 1);
        }
        i = i + 1;
    }
    return plan;
}

fn fmt_step_ver(sb, ver) {
    if (str_len(ver) > 0) {
        str_builder_add_cstr(sb, " (");
        str_builder_add(sb, ver);
        str_builder_add_cstr(sb, ")");
    } else { str_builder_add_cstr(sb, " (latest)"); }
}

fn fmt_step_cmd(sb, cmd, st) {
    str_builder_add_cstr(sb, cmd);
    str_builder_add(sb, istep_pkg(st));
    fmt_step_ver(sb, istep_ver(st));
}

fn ark_format_plan(plan) {
    var output = ark_output_new();
    ark_output_add(output, output_line_header(str_from("Execution plan")));
    var steps = iplan_steps(plan);
    if (vec_len(steps) == 0) {
        ark_output_add(output, output_line_warning(str_from("No steps in plan")));
        return output;
    }
    var i = 0;
    while (i < vec_len(steps)) {
        var st = vec_get(steps, i);
        var sb = str_builder_new();
        str_builder_add_int(sb, i + 1);
        str_builder_add_cstr(sb, ". ");
        var stag = istep_tag(st);
        if (stag == STEP_SYSTEM_INSTALL) { fmt_step_cmd(sb, "apt-get install ", st); }
        if (stag == STEP_SYSTEM_REMOVE) {
            if (istep_purge(st)) { str_builder_add_cstr(sb, "apt-get purge "); }
            else { str_builder_add_cstr(sb, "apt-get remove "); }
            str_builder_add(sb, istep_pkg(st));
        }
        if (stag == STEP_MARKETPLACE_INSTALL) { fmt_step_cmd(sb, "marketplace install ", st); }
        if (stag == STEP_MARKETPLACE_REMOVE) {
            str_builder_add_cstr(sb, "marketplace remove ");
            str_builder_add(sb, istep_pkg(st));
        }
        if (stag == STEP_FLUTTER_INSTALL) { fmt_step_cmd(sb, "agpkg install ", st); }
        if (stag == STEP_FLUTTER_REMOVE) {
            str_builder_add_cstr(sb, "agpkg remove ");
            str_builder_add(sb, istep_pkg(st));
        }
        if (stag == STEP_SYSTEM_UPDATE) { str_builder_add_cstr(sb, "apt-get update"); }
        ark_output_add(output, output_line_info(str_from("Step"), str_builder_build(sb)));
        i = i + 1;
    }
    ark_output_add(output, output_line_separator());
    if (iplan_root(plan)) {
        ark_output_add(output, output_line_info(str_from("Requires root"), str_from("true")));
    } else {
        ark_output_add(output, output_line_info(str_from("Requires root"), str_from("false")));
    }
    var ssb = str_builder_new();
    str_builder_add_int(ssb, iplan_size(plan));
    str_builder_add_cstr(ssb, " bytes");
    ark_output_add(output, output_line_info(str_from("Estimated size"), str_builder_build(ssb)));
    return output;
}
