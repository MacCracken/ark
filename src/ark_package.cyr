# =========================================================================
# ark_package.cyr — reader for the takumi `.ark` v1 package format.
#
# takumi builds and writes `.ark` packages (see takumi
# docs/adr/0001-ark-binary-format.md and src/ark_format.cyr); ark is the
# consumer and needs a matching reader. This module reads a `.ark` file,
# verifies its integrity (SHA-256 root hash over the whole prefix) and
# optional ed25519 signature, parses the manifest + file index, inflates
# the DEFLATE data block, and re-verifies every per-file content hash.
#
# Layout (little-endian; strings are u32-len + raw bytes; hashes/keys/sigs
# are raw bytes 32/32/64):
#
#   HEADER (16B): 0x89 'A' 'R' 'K' | u16 version | u16 flags
#                 | u8 compress_algo | u8 compress_level
#                 | u8 hash_algo | u8 sig_algo | u32 reserved
#   MANIFEST:     u32 len | TOML text ([[manifest]] table, escaped)
#   FILE-INDEX:   u32 count | entries (sorted by path):
#                   u8 file_type | u8 eflags(bit0 has_sha,bit1 has_target)
#                   | u32 path_len | path | u64 size
#                   | [32B sha256] | [u32 tlen | target] | u64 data_offset
#   DATA:         u64 uncompressed_len | u64 compressed_len | deflate bytes
#   TRAILER:      32B root_hash | u8 has_sig | [32B pubkey | 64B signature]
#
# Manifest TOML escaping is symmetric: takumi escapes (\, ", \n, \t, \r);
# bayan delimits escaped strings but does NOT un-escape, so we un-escape
# here (mirrors takumi's reader; verified against bayan 2.3.1).
# =========================================================================

# --- format constants (mirror takumi's ArkFmt) -----------------------
enum ArkPkgFmt {
    ARK_FORMAT_VERSION = 1;
    ARK_FLAG_SIGNED = 1;
    ARK_FLAG_COMPRESSED = 2;
    ARK_HEADER_LEN = 16;
    ARK_FT_REGULAR = 0;
    ARK_FT_DIRECTORY = 1;
    ARK_FT_SYMLINK = 2;
    ARK_FT_CONFIG = 3;
    # Decompression-bomb cap: reject a declared uncompressed size above 256 MiB
    # before allocating, so a tiny `.ark` can't claim a huge `u_len`.
    ARK_MAX_DATA = 268435456;
}

# --- little-endian readers over a raw byte buffer ---------------------
fn apkg_u8(buf, off) { return load8(buf + off) & 0xFF; }
fn apkg_u16(buf, off) { return apkg_u8(buf, off) | (apkg_u8(buf, off + 1) << 8); }
fn apkg_u32(buf, off) { return apkg_u16(buf, off) | (apkg_u16(buf, off + 2) << 16); }
fn apkg_u64(buf, off) { return apkg_u32(buf, off) | (apkg_u32(buf, off + 4) << 32); }

# --- manifest model (13 fields, field order == takumi's writer) -------
# name(0) version(8) release(16) description(24) arch(32) size_installed(40)
# build_date(48) builder(56) source_url(64) source_hash(72) license(80)
# groups(88) depends(96)  => 104 bytes
fn apkg_man_name(m) { return load64(m); }
fn apkg_man_version(m) { return load64(m + 8); }
fn apkg_man_release(m) { return load64(m + 16); }
fn apkg_man_description(m) { return load64(m + 24); }
fn apkg_man_arch(m) { return load64(m + 32); }
fn apkg_man_size_installed(m) { return load64(m + 40); }
fn apkg_man_build_date(m) { return load64(m + 48); }
fn apkg_man_builder(m) { return load64(m + 56); }
fn apkg_man_source_url(m) { return load64(m + 64); }
fn apkg_man_source_hash(m) { return load64(m + 72); }
fn apkg_man_license(m) { return load64(m + 80); }
fn apkg_man_groups(m) { return load64(m + 88); }
fn apkg_man_depends(m) { return load64(m + 96); }

# --- file-entry model -------------------------------------------------
# path(0) sha_hex(8) size(16) file_type(24) symlink_target(32)
# data_offset(40)  => 48 bytes. data_offset is the byte offset of this
# entry's payload within the inflated data block.
fn apkg_afe_path(e) { return load64(e); }
fn apkg_afe_sha256(e) { return load64(e + 8); }
fn apkg_afe_size(e) { return load64(e + 16); }
fn apkg_afe_file_type(e) { return load64(e + 24); }
fn apkg_afe_symlink_target(e) { return load64(e + 32); }
fn apkg_afe_data_offset(e) { return load64(e + 40); }

fn apkg_afe_new(path, sha_hex, size, ftype, target, data_offset) {
    var e = alloc(48);
    store64(e, path);
    store64(e + 8, sha_hex);
    store64(e + 16, size);
    store64(e + 24, ftype);
    store64(e + 32, target);
    store64(e + 40, data_offset);
    return e;
}

fn apkg_afe_has_payload(e) {
    var t = apkg_afe_file_type(e);
    if (t == ARK_FT_REGULAR) { return 1; }
    if (t == ARK_FT_CONFIG) { return 1; }
    return 0;
}

# --- package model ----------------------------------------------------
# manifest(0) sig_hex(8) entries(16) data_hash(24) data(32) data_len(40)
# pubkey(48) — hex of the signer's embedded Ed25519 pubkey ("" if unsigned)
fn apkg_manifest(p) { return load64(p); }
fn apkg_sig_hex(p) { return load64(p + 8); }
fn apkg_entries(p) { return load64(p + 16); }
fn apkg_data_hash(p) { return load64(p + 24); }
fn apkg_data(p) { return load64(p + 32); }
fn apkg_data_len(p) { return load64(p + 40); }
fn apkg_pubkey(p) { return load64(p + 48); }

fn apkg_new(manifest, sig_hex, entries, data_hash, data, data_len, pubkey) {
    var p = alloc(56);
    store64(p, manifest);
    store64(p + 8, sig_hex);
    store64(p + 16, entries);
    store64(p + 24, data_hash);
    store64(p + 32, data);
    store64(p + 40, data_len);
    store64(p + 48, pubkey);
    return p;
}

# --- manifest TOML un-escape (reverse takumi's escaping) --------------
# Returns a fresh NUL-terminated cstr.
fn apkg_unescape_bytes(data, n) {
    var buf = alloc(n + 1);
    var o = 0;
    var i = 0;
    while (i < n) {
        var c = load8(data + i) & 0xFF;
        if (c == 92) {
            if (i + 1 < n) {
                var d = load8(data + i + 1) & 0xFF;
                if (d == 92) { store8(buf + o, 92); o = o + 1; i = i + 2; }
                else { if (d == 34) { store8(buf + o, 34); o = o + 1; i = i + 2; }
                    else { if (d == 110) { store8(buf + o, 10); o = o + 1; i = i + 2; }
                        else { if (d == 116) { store8(buf + o, 9); o = o + 1; i = i + 2; }
                            else { if (d == 114) { store8(buf + o, 13); o = o + 1; i = i + 2; }
                                else { store8(buf + o, c); o = o + 1; i = i + 1; } } } } }
            } else {
                store8(buf + o, c); o = o + 1; i = i + 1;
            }
        } else {
            store8(buf + o, c); o = o + 1; i = i + 1;
        }
    }
    store8(buf + o, 0);
    return buf;
}

fn apkg_unescape_str(s) { return apkg_unescape_bytes(str_data(s), str_len(s)); }
fn apkg_unescape_cstr(c) { return apkg_unescape_bytes(c, strlen(c)); }

# --- manifest parsing -------------------------------------------------
fn apkg_find_section(sections, name) {
    var i = 0;
    var n = vec_len(sections);
    while (i < n) {
        var s = vec_get(sections, i);
        if (str_eq_cstr(toml_section_name(s), name) == 1) {
            return toml_section_pairs(s);
        }
        i = i + 1;
    }
    return 0;
}

fn apkg_get_str(pairs, key) {
    var s = toml_get(pairs, key);
    if (s == 0) { return 0; }
    return apkg_unescape_str(s);
}

fn apkg_get_int(pairs, key, fallback) {
    var s = toml_get(pairs, key);
    if (s == 0) { return fallback; }
    return str_to_int(s);
}

# Parse an inline array of basic strings into a vec of cstr (un-escaped).
fn apkg_parse_array(arr_str) {
    var out = vec_new();
    if (arr_str == 0) { return out; }
    var data = str_data(arr_str);
    var len = str_len(arr_str);
    var pos = 0;
    while (pos < len) {
        if (load8(data + pos) == 34) {
            pos = pos + 1;
            var start = pos;
            while (pos < len) {
                if (load8(data + pos) == 34) { break; }
                pos = pos + 1;
            }
            var slen = pos - start;
            vec_push(out, apkg_unescape_bytes(data + start, slen));
            pos = pos + 1;
        } else {
            pos = pos + 1;
        }
    }
    return out;
}

fn apkg_get_arr(pairs, key) {
    return apkg_parse_array(toml_get(pairs, key));
}

fn apkg_man_from_pairs(pairs) {
    var m = alloc(104);
    store64(m, apkg_get_str(pairs, "name"));
    store64(m + 8, apkg_get_str(pairs, "version"));
    store64(m + 16, apkg_get_int(pairs, "release", 1));
    store64(m + 24, apkg_get_str(pairs, "description"));
    store64(m + 32, apkg_get_str(pairs, "arch"));
    store64(m + 40, apkg_get_int(pairs, "size_installed", 0));
    store64(m + 48, apkg_get_int(pairs, "build_date", 0));
    store64(m + 56, apkg_get_str(pairs, "builder"));
    store64(m + 64, apkg_get_str(pairs, "source_url"));
    store64(m + 72, apkg_get_str(pairs, "source_hash"));
    store64(m + 80, apkg_get_str(pairs, "license"));
    store64(m + 88, apkg_get_arr(pairs, "groups"));
    store64(m + 96, apkg_get_arr(pairs, "depends"));
    return m;
}

# --- reader -----------------------------------------------------------
# Read + fully verify a `.ark` file. Returns an ark package handle on
# success, or 0 if the file is malformed, the version is unknown, the
# root hash mismatches, the signature fails, or any per-file content
# hash mismatches. `max_len` caps the read (whole file buffered in
# memory — see the ADR's size note).
fn ark_pkg_read(path_cstr, max_len) {
    var buf = alloc(max_len);
    var flen = file_read_all(path_cstr, buf, max_len);
    if (flen < ARK_HEADER_LEN) { return 0; }

    # Header: magic + version.
    if (apkg_u8(buf, 0) != 0x89) { return 0; }
    if (apkg_u8(buf, 1) != 65) { return 0; }
    if (apkg_u8(buf, 2) != 82) { return 0; }
    if (apkg_u8(buf, 3) != 75) { return 0; }
    if (apkg_u16(buf, 4) != ARK_FORMAT_VERSION) { return 0; }
    var flags = apkg_u16(buf, 6);
    var signed = flags & ARK_FLAG_SIGNED;
    var compressed = flags & ARK_FLAG_COMPRESSED;

    # Trailer geometry: [root 32][has_sig 1][pubkey 32][sig 64]?
    var trailer = 33;
    if (signed != 0) { trailer = trailer + 96; }
    var r = flen - trailer;
    if (r < ARK_HEADER_LEN) { return 0; }

    # Verify the SHA-256 root hash over the prefix [0, R).
    sha256_global_init();
    var ctx = sha256_init();
    sha256_update(ctx, buf, r);
    var calc = alloc(32);
    sha256_finalize(ctx, calc);
    fl_free(ctx);
    if (memeq(calc, buf + r, 32) != 1) { return 0; }

    # Verify the ed25519 signature over the root hash, if present. Capture the
    # signer's pubkey (hex) so the caller can anchor trust (the signature alone
    # only proves not-modified-after-signing — see docs/audit/2026-06-18).
    var sig_hex = "";
    var pubkey_hex = "";
    if (signed != 0) {
        var pk = buf + r + 33;
        var sig = buf + r + 33 + 32;
        if (ed25519_verify(pk, buf + r, 32, sig) != 1) { return 0; }
        sig_hex = hex_encode(sig, 64);
        pubkey_hex = hex_encode(pk, 32);
    }

    # Manifest (uncompressed TOML). All reads are bounded by `r` (the verified
    # prefix length) so a malformed `.ark` can't drive an out-of-bounds read.
    var off = ARK_HEADER_LEN;
    if (off + 4 > r) { return 0; }
    var mlen = apkg_u32(buf, off);
    off = off + 4;
    if (off + mlen > r) { return 0; }
    var mstr = str_new(buf + off, mlen);
    off = off + mlen;
    var sections = toml_parse(mstr);
    var pairs = apkg_find_section(sections, "manifest");
    if (pairs == 0) { return 0; }
    var manifest = apkg_man_from_pairs(pairs);

    # File index.
    if (off + 4 > r) { return 0; }
    var count = apkg_u32(buf, off);
    off = off + 4;
    var entries = vec_new();
    var i = 0;
    while (i < count) {
        if (off + 6 > r) { return 0; }
        var ft = apkg_u8(buf, off); off = off + 1;
        var eflags = apkg_u8(buf, off); off = off + 1;
        var plen = apkg_u32(buf, off); off = off + 4;
        if (off + plen > r) { return 0; }
        var path = alloc(plen + 1);
        memcpy(path, buf + off, plen);
        store8(path + plen, 0);
        off = off + plen;
        if (off + 8 > r) { return 0; }
        var size = apkg_u64(buf, off); off = off + 8;
        var sha_hex = "";
        if ((eflags & 1) != 0) {
            if (off + 32 > r) { return 0; }
            sha_hex = hex_encode(buf + off, 32);
            off = off + 32;
        }
        var target = 0;
        if ((eflags & 2) != 0) {
            if (off + 4 > r) { return 0; }
            var tlen = apkg_u32(buf, off); off = off + 4;
            if (off + tlen > r) { return 0; }
            target = alloc(tlen + 1);
            memcpy(target, buf + off, tlen);
            store8(target + tlen, 0);
            off = off + tlen;
        }
        if (off + 8 > r) { return 0; }
        var doff = apkg_u64(buf, off); off = off + 8;
        vec_push(entries, apkg_afe_new(path, sha_hex, size, ft, target, doff));
        i = i + 1;
    }

    # Data block: inflate. Bound the declared sizes before allocating, both
    # against the file (compressed bytes must fit in `r`) and against the
    # decompression-bomb cap (`u_len`).
    if (off + 16 > r) { return 0; }
    var u_len = apkg_u64(buf, off); off = off + 8;
    var c_len = apkg_u64(buf, off); off = off + 8;
    if (c_len > r) { return 0; }
    if (off + c_len > r) { return 0; }
    if (u_len > ARK_MAX_DATA) { return 0; }
    var data = 0;
    if (u_len > 0) {
        data = alloc(u_len);
        if (compressed != 0) {
            var n = deflate_decompress(buf + off, c_len, data, u_len);
            if (n != u_len) { return 0; }
        } else {
            if (off + u_len > r) { return 0; }
            memcpy(data, buf + off, u_len);
        }
    }

    # Re-verify each payload's content hash against the index.
    i = 0;
    var cursor = 0;
    while (i < count) {
        var e = vec_get(entries, i);
        if (apkg_afe_has_payload(e) == 1) {
            var sz = apkg_afe_size(e);
            # Payload must lie within the inflated buffer (no OOB hash read).
            if (cursor + sz > u_len) { return 0; }
            var hh = apkg_afe_sha256(e);
            if (hh != 0) {
                if (strlen(hh) == 64) {
                    sha256_global_init();
                    var c2 = sha256_init();
                    sha256_update(c2, data + cursor, sz);
                    var dg = alloc(32);
                    sha256_finalize(c2, dg);
                    fl_free(c2);
                    var want = alloc(32);
                    hex_decode_into(hh, 64, want);
                    if (memeq(dg, want, 32) != 1) { return 0; }
                }
            }
            cursor = cursor + sz;
        }
        i = i + 1;
    }

    # Whole-data hash (matches takumi's data_hash field).
    var data_hash = "";
    if (u_len > 0) {
        sha256_global_init();
        var c3 = sha256_init();
        sha256_update(c3, data, u_len);
        var dh = alloc(32);
        sha256_finalize(c3, dh);
        fl_free(c3);
        data_hash = hex_encode(dh, 32);
    }
    return apkg_new(manifest, sig_hex, entries, data_hash, data, u_len, pubkey_hex);
}

# --- trust anchor -----------------------------------------------------
# The .ark signature is verified against the package's OWN embedded pubkey, so
# it proves integrity-after-signing but NOT publisher identity. A trust anchor
# closes that: the signer's pubkey must be in a configured set of trusted keys.

# Load a trusted-key set from a newline-delimited file of hex Ed25519 pubkeys
# (one per line; blank lines ignored). Returns a map keyed by hex cstr; an
# absent/empty file yields an empty (trust-nothing) set.
fn ark_trust_load(path_cstr) {
    var store = map_new();
    var buf = alloc(65536);
    var n = file_read_all(path_cstr, buf, 65536);
    if (n <= 0) { return store; }
    var lines = str_split(str_new(buf, n), 10);
    var i = 0;
    while (i < vec_len(lines)) {
        var ln = str_trim(vec_get(lines, i));
        var l = str_len(ln);
        if (l > 0) {
            var kb = alloc(l + 1);
            memcpy(kb, str_data(ln), l);
            store8(kb + l, 0);
            map_set(store, kb, 1);
        }
        i = i + 1;
    }
    return store;
}

# 1 if the package is signed AND its signer pubkey is in the trust set.
fn ark_pkg_signer_trusted(p, store) {
    var pk = apkg_pubkey(p);
    if (pk == 0) { return 0; }
    if (strlen(pk) == 0) { return 0; }
    if (map_get(store, pk) > 0) { return 1; }
    return 0;
}

# Build an ark trust set from a mela publisher keyring: every key version's
# public key becomes a trusted hex key. This anchors `.ark` signatures to
# mela's keyring (the marketplace's publisher identities) rather than a
# separately-provisioned key file.
fn ark_trust_from_keyring(kr) {
    var store = map_new();
    var ids = map_keys(kr);
    var i = 0;
    while (i < vec_len(ids)) {
        var versions = mela_keyring_get_all_versions(kr, vec_get(ids, i));
        var j = 0;
        while (j < vec_len(versions)) {
            var pkhex = mela_kv_public_key_hex(vec_get(versions, j));
            var l = str_len(pkhex);
            var kb = alloc(l + 1);
            memcpy(kb, str_data(pkhex), l);
            store8(kb + l, 0);
            map_set(store, kb, 1);
            j = j + 1;
        }
        i = i + 1;
    }
    return store;
}

# Load a mela keyring directory and build an ark trust set from it.
fn ark_trust_load_keyring(dir_cstr) {
    var kr = mela_keyring_new();
    keyring_load_dir(kr, str_from(dir_cstr));
    return ark_trust_from_keyring(kr);
}

# --- installer --------------------------------------------------------
# Materializes a verified `.ark` to disk and registers it in PackageDb.

# Whether an install target string is a local `.ark` file path.
fn apkg_is_ark_path(s) {
    return str_ends_with(s, str_from(".ark"));
}

# CLI entry: install a local `.ark` file. `root_str` "" (or empty) installs
# to the real root; a non-empty value stages under that directory. The
# 128 MiB cap bounds the in-memory read (see the ADR's size note).
fn ark_install_local(mgr, path_str, root_str) {
    var root = "";
    if (root_str != 0) {
        if (str_len(root_str) > 0) { root = str_data(root_str); }
    }
    return ark_pkg_install(mgr, str_data(path_str), root, 134217728);
}

# Concatenate install_root + package path into a fresh cstr. Package
# paths carry a leading slash, so root "" yields the real absolute path
# and root "/tmp/x" yields a rooted path (for tests / staging).
fn apkg_join(root, path) {
    var lr = strlen(root);
    var lp = strlen(path);
    var buf = alloc(lr + lp + 1);
    if (lr > 0) { memcpy(buf, root, lr); }
    if (lp > 0) { memcpy(buf + lr, path, lp); }
    store8(buf + lr + lp, 0);
    return buf;
}

# mkdir -p: create every path component of `path` (including itself).
# Existing dirs (EEXIST) are ignored.
fn apkg_mkdir_p(path) {
    var n = strlen(path);
    if (n == 0) { return 0; }
    var buf = alloc(n + 1);
    memcpy(buf, path, n);
    store8(buf + n, 0);
    var i = 1;
    while (i < n) {
        if (load8(buf + i) == 47) {
            store8(buf + i, 0);
            sys_mkdir(buf, 493);
            store8(buf + i, 47);
        }
        i = i + 1;
    }
    sys_mkdir(buf, 493);
    return 0;
}

# mkdir -p for the parent directory of a file path (everything up to the
# last '/'). No-op if the path has no directory component.
fn apkg_mkdir_parents(path) {
    var n = strlen(path);
    var last = 0 - 1;
    var i = 0;
    while (i < n) {
        if (load8(path + i) == 47) { last = i; }
        i = i + 1;
    }
    if (last <= 0) { return 0; }
    var buf = alloc(last + 1);
    memcpy(buf, path, last);
    store8(buf + last, 0);
    apkg_mkdir_p(buf);
    return 0;
}

# Zip-slip / path-traversal guard (CWE-22). A `.ark` entry path is
# absolute-under-root (leading '/') and must contain no ".." component, so it
# cannot escape the install root. Returns 1 if safe, 0 otherwise. ".." is only
# rejected as a whole path component, so legitimate names like "lib..so" pass.
fn apkg_path_safe(pathc) {
    var n = strlen(pathc);
    if (n == 0) { return 0; }
    if (load8(pathc) != 47) { return 0; }
    var i = 0;
    while (i < n) {
        if (load8(pathc + i) == 46) {
            if (i + 1 < n) {
                if (load8(pathc + i + 1) == 46) {
                    var before_slash = 0;
                    if (i == 0) { before_slash = 1; }
                    else { if (load8(pathc + i - 1) == 47) { before_slash = 1; } }
                    var after_slash = 0;
                    if (i + 2 == n) { after_slash = 1; }
                    else { if (load8(pathc + i + 2) == 47) { after_slash = 1; } }
                    if (before_slash == 1) { if (after_slash == 1) { return 0; } }
                }
            }
        }
        i = i + 1;
    }
    return 1;
}

# Read + verify a `.ark`, lay its files down under `install_root_cstr`
# (use "" for the real root), and register the package in the manager's
# PackageDb with per-file hashes + signature. Records an install
# transaction. Returns an ArkResult (success/0 on read/verify failure).
# Read + verify + trust-gate + materialize + register a `.ark`. When
# record_txn==1 it also records a standalone install transaction (the
# `ark install ./pkg.ark` path); when 0 the caller owns the transaction (the
# executor records the op in its plan-wide txn — M1), so there is no nested
# transaction. install_root_cstr "" = real root.
fn ark_pkg_install_inner(mgr, ark_path_cstr, install_root_cstr, max_len, record_txn, source) {
    var p = ark_pkg_read(ark_path_cstr, max_len);
    if (p == 0) {
        return ark_result_new(0, str_from("ark: package read or verification failed"),
        vec_new(), SOURCE_MARKETPLACE);
    }
    # Trust gate: when policy requires it, the signer must be in the trust set
    # (anchors the signature to a known publisher) — else refuse, fail closed.
    var tcfg = amgr_config(mgr);
    if (acfg_require_signed(tcfg) == 1) {
        var store = ark_trust_load(str_data(acfg_trust_keys(tcfg)));
        if (ark_pkg_signer_trusted(p, store) == 0) {
            return ark_result_new(0,
            str_from("ark: refusing install — package signer not trusted (require_signed)"),
            vec_new(), SOURCE_MARKETPLACE);
        }
    }
    var m = apkg_manifest(p);
    var name = str_from(apkg_man_name(m));
    var version = str_from(apkg_man_version(m));
    var entry = db_entry_new(name, version, source);
    var files = pdbe_files(entry);
    var data = apkg_data(p);
    var entries = apkg_entries(p);

    # Zip-slip guard: reject the whole package if ANY entry path could escape
    # the install root — before writing a single file (no partial install).
    var gi = 0;
    while (gi < vec_len(entries)) {
        var ge = vec_get(entries, gi);
        if (apkg_path_safe(apkg_afe_path(ge)) == 0) {
            return ark_result_new(0,
            str_from("ark: refusing install — unsafe package path (traversal)"),
            vec_new(), SOURCE_MARKETPLACE);
        }
        # Fail closed on a target without symlink support (agnos) rather than
        # registering a symlink that was never created (M3 — see portable.cyr).
        if (apkg_afe_file_type(ge) == ARK_FT_SYMLINK) {
            if (ark_symlink_supported() == 0) {
                return ark_result_new(0,
                str_from("ark: refusing install — symlink entries unsupported on this target"),
                vec_new(), SOURCE_MARKETPLACE);
            }
        }
        gi = gi + 1;
    }

    # Upgrade-replace: if a previous version of this package is registered,
    # unlink its owned files first so an upgrade doesn't orphan files the new
    # version no longer ships (shared paths are re-materialized in pass 1).
    var prev = pkg_db_get(amgr_db(mgr), str_data(name));
    if (prev != 0) {
        var pvf = pdbe_files(prev);
        var pvi = 0;
        while (pvi < vec_len(pvf)) {
            ark_unlink(apkg_join(install_root_cstr, str_data(vec_get(pvf, pvi))));
            pvi = pvi + 1;
        }
    }

    # Pass 1 — directories + regular/config files. Symlinks are deferred to
    # pass 2 so a malicious symlink entry can't be planted and then have a
    # later same-archive write redirected through it (audit #5): when these
    # writes run, no archive symlink exists yet, so every parent is a real dir.
    var i = 0;
    var nfiles = 0;
    while (i < vec_len(entries)) {
        var e = vec_get(entries, i);
        var ft = apkg_afe_file_type(e);
        if (ft != ARK_FT_SYMLINK) {
            var pathc = apkg_afe_path(e);
            var full = apkg_join(install_root_cstr, pathc);
            if (ft == ARK_FT_DIRECTORY) {
                apkg_mkdir_p(full);
            } else {
                apkg_mkdir_parents(full);
                file_write_all(full, data + apkg_afe_data_offset(e), apkg_afe_size(e));
                var pstr = str_from(pathc);
                vec_push(files, pstr);
                var hh = apkg_afe_sha256(e);
                if (hh != 0) {
                    if (strlen(hh) == 64) { pdbe_set_file_hash(entry, pstr, str_from(hh)); }
                }
                nfiles = nfiles + 1;
            }
        }
        i = i + 1;
    }
    # Pass 2 — symlinks, created last (their parents are now real dirs/files).
    i = 0;
    while (i < vec_len(entries)) {
        var es = vec_get(entries, i);
        if (apkg_afe_file_type(es) == ARK_FT_SYMLINK) {
            var spath = apkg_afe_path(es);
            var sfull = apkg_join(install_root_cstr, spath);
            apkg_mkdir_parents(sfull);
            ark_symlink(apkg_afe_symlink_target(es), sfull);
            vec_push(files, str_from(spath));
            nfiles = nfiles + 1;
        }
        i = i + 1;
    }

    pdbe_set_size(entry, apkg_man_size_installed(m));
    var sig = apkg_sig_hex(p);
    if (sig != 0) {
        if (strlen(sig) > 0) { pdbe_set_signature(entry, str_from(sig)); }
    }
    pkg_db_register(amgr_db(mgr), entry);
    # Persist the store to disk — every ark process reloads packages.json, so an
    # in-memory-only register would be lost across the CLI lifecycle.
    pkg_db_save(amgr_db(mgr));

    # Record the install in the transaction log, unless the caller owns the
    # transaction (executor path — the op is recorded in the plan-wide txn).
    if (record_txn == 1) {
        var log = amgr_log(mgr);
        var tid = txn_log_begin(log, exec_current_user());
        txn_log_add_op(log, tid, txn_op_new(OP_INSTALL, name, version, source));
        txn_log_mark_op_complete(log, tid, name);
        txn_log_commit(log, tid);
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Installed ");
    str_builder_add(sb, name);
    str_builder_add_cstr(sb, " ");
    str_builder_add(sb, version);
    str_builder_add_cstr(sb, " (");
    str_builder_add_int(sb, nfiles);
    str_builder_add_cstr(sb, " files)");
    var affected = vec_new();
    vec_push(affected, name);
    return ark_result_new(1, str_builder_build(sb), affected, source);
}

# Public install: read+verify+materialize+register AND record its own
# transaction (the standalone `ark install ./pkg.ark` / marketplace path).
# A standalone local/marketplace `.ark` registers as SOURCE_MARKETPLACE.
fn ark_pkg_install(mgr, ark_path_cstr, install_root_cstr, max_len) {
    return ark_pkg_install_inner(mgr, ark_path_cstr, install_root_cstr, max_len, 1, SOURCE_MARKETPLACE);
}

# Native remove: unregister a package from the PackageDb store and unlink its
# owned files under install_root_cstr ("" = real root). The authoritative
# record of what's installed is the PackageDb (ark never shells dpkg-query),
# so removal is store-driven. When record_txn==1 it records a standalone
# remove transaction; when 0 the caller owns the txn (executor / rollback).
# Returns an ArkResult; success even if some files were already gone.
fn ark_pkg_remove_inner(mgr, name_str, install_root_cstr, record_txn) {
    var db = amgr_db(mgr);
    var entry = pkg_db_get(db, str_data(name_str));
    if (entry == 0) {
        var em = str_builder_new();
        str_builder_add_cstr(em, "ark: not installed: ");
        str_builder_add(em, name_str);
        return ark_result_new(0, str_builder_build(em), vec_new(), SOURCE_MARKETPLACE);
    }
    var version = pdbe_version(entry);
    var esrc = pdbe_source(entry);
    # Unlink owned files (deepest-last order is irrelevant for plain files).
    var files = pdbe_files(entry);
    var i = 0;
    while (i < vec_len(files)) {
        var full = apkg_join(install_root_cstr, str_data(vec_get(files, i)));
        ark_unlink(full);
        i = i + 1;
    }
    pkg_db_unregister(db, name_str);
    # Persist the store — the removal must survive across CLI processes.
    pkg_db_save(db);

    if (record_txn == 1) {
        var log = amgr_log(mgr);
        var tid = txn_log_begin(log, exec_current_user());
        txn_log_add_op(log, tid, txn_op_new(OP_REMOVE, name_str, version, esrc));
        txn_log_mark_op_complete(log, tid, name_str);
        txn_log_commit(log, tid);
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Removed ");
    str_builder_add(sb, name_str);
    var affected = vec_new();
    vec_push(affected, name_str);
    return ark_result_new(1, str_builder_build(sb), affected, esrc);
}
