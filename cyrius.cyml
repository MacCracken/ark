[package]
name = "ark"
# ⚠ Read from the VERSION file, not restated here — every other repo in the ecosystem
# uses this form. Hardcoding it made cyrius.cyml a SECOND source of truth and it drifted:
# VERSION said 1.4.2 while this said 1.4.1 (v6.6.2). Same class as the `.cyrius-toolchain`
# file removed in the same release.
version = "${file:VERSION}"
description = "ark - Cyrius port"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.9"

[build]
entry = "src/main.cyr"
output = "ark"
defines = ["ARK_MAIN"]

# sigil, sankoch and sandhi ship folded into the cyrius stdlib, so they are stdlib
# leaves here rather than `[deps.*]` git blocks.
[deps]
stdlib = ["string", "fmt", "alloc", "vec", "str", "slice", "syscalls", "io", "args", "assert", "hashmap", "tagged", "fs", "freelist", "chrono", "process", "result", "fnptr", "bench", "bayan", "ct", "random", "keccak", "thread_local", "sankoch", "sync", "trait", "sakshi", "thread", "net", "async", "atomic", "mmap", "dynlib", "fdlopen", "regression", "http", "tls", "ws", "sigil", "sandhi"]

# No `path = "../<dep>"` overrides. From cyrius 6.7.6 a `path` beside `git`/`tag` is a
# local-mode-only dev override (CYRIUS_LOCAL=1 / --local); a default build always
# builds the tag. Each tag below is the last one pinned to this cyrius.
[deps.nous]
git = "https://github.com/MacCracken/nous.git"
tag = "1.5.0"
modules = ["dist/nous.cyr"]

# mela — AGNOS marketplace layer (signed/integrity-checked/transparency-logged).
# 0.9.3 namespaced its public API (mela_*) so it co-bundles with nous without
# symbol collisions. agnostik is mela's transitive dep; sandhi (stdlib) supplies
# the HTTP/TLS transport for marketplace downloads.
[deps.mela]
git = "https://github.com/MacCracken/mela.git"
tag = "1.1.6"
modules = ["dist/mela.cyr"]

[deps.agnostik]
git = "https://github.com/MacCracken/agnostik.git"
tag = "1.12.0"
modules = ["dist/agnostik.cyr"]
