[package]
name = "ark"
version = "0.8.8"
description = "ark - Cyrius port"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.2.20"

[build]
entry = "src/main.cyr"
output = "ark"
defines = ["ARK_MAIN"]

[deps]
stdlib = ["string", "fmt", "alloc", "vec", "str", "slice", "syscalls", "io", "args", "assert", "hashmap", "tagged", "fs", "freelist", "chrono", "process", "result", "fnptr", "bench", "bayan", "ct", "random", "keccak", "thread_local", "sankoch", "sync"]

[deps.sigil]
git = "https://github.com/MacCracken/sigil.git"
path = "../sigil"
tag = "3.8.0"
modules = ["dist/sigil.cyr"]

[deps.nous]
git = "https://github.com/MacCracken/nous.git"
path = "../nous"
tag = "1.2.7"
modules = ["dist/nous.cyr"]
