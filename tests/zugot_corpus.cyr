# zugot corpus validation harness (v0.9.0 quality gate).
#
# Parses every recipe in the zugot corpus with ark's own recipe parser and
# reports parse failures + validation warnings. Evidence for the v1.0
# criterion "recipe parsing validated against the full zugot corpus".
#
# Usage: regenerate the path list, then run:
#   find ../zugot -name '*.cyml' | sort > /tmp/zugot-list.txt
#   cyrius run tests/zugot_corpus.cyr
# Reads the newline-delimited recipe paths from /tmp/zugot-list.txt (no
# readdir wrapper in stdlib yet). Exits non-zero if any recipe fails to parse.

include "src/types.cyr"
include "src/portable.cyr"
include "src/output.cyr"
include "src/transaction.cyr"
include "src/db.cyr"
include "src/engine.cyr"
include "src/exec.cyr"
include "src/recipe.cyr"
include "src/ark_package.cyr"
include "src/marketplace.cyr"
include "src/bazaar.cyr"
include "src/cli.cyr"

fn main() {
    alloc_init();
    var listbuf = alloc(1048576);
    var n = file_read_all("/tmp/zugot-list.txt", listbuf, 1048576);
    if (n <= 0) {
        print("zugot_corpus: cannot read /tmp/zugot-list.txt\n", 44);
        print("  run: find ../zugot -name '*.cyml' | sort > /tmp/zugot-list.txt\n", 64);
        return 1;
    }
    var lines = str_split(str_new(listbuf, n), 10);

    var total = 0;
    var ok = 0;
    var failed = 0;
    var warns = 0;
    var i = 0;
    while (i < vec_len(lines)) {
        var raw = str_trim(vec_get(lines, i));
        if (str_len(raw) > 0) {
            total = total + 1;
            # str_split returns slices into the list buffer (not NUL-terminated);
            # file_open needs a NUL-terminated cstr, so copy into a fresh buffer.
            var pl = str_len(raw);
            var pb = alloc(pl + 1);
            memcpy(pb, str_data(raw), pl);
            store8(pb + pl, 0);
            var path = str_new(pb, pl);
            var rr = recipe_parse_file(path);
            if (is_ok(rr) == 1) {
                ok = ok + 1;
                var errs = recipe_validate(result_unwrap(rr));
                if (vec_len(errs) > 0) { warns = warns + 1; }
            } else {
                failed = failed + 1;
                var sb = str_builder_new();
                str_builder_add_cstr(sb, "  PARSE FAIL: ");
                str_builder_add(sb, path);
                str_builder_add_cstr(sb, "\n");
                var m = str_builder_build(sb);
                print(str_data(m), str_len(m));
            }
        }
        i = i + 1;
    }

    var sb2 = str_builder_new();
    str_builder_add_cstr(sb2, "zugot corpus: ");
    str_builder_add_int(sb2, ok);
    str_builder_add_cstr(sb2, "/");
    str_builder_add_int(sb2, total);
    str_builder_add_cstr(sb2, " parsed, ");
    str_builder_add_int(sb2, failed);
    str_builder_add_cstr(sb2, " failed, ");
    str_builder_add_int(sb2, warns);
    str_builder_add_cstr(sb2, " with validation warnings\n");
    var out = str_builder_build(sb2);
    print(str_data(out), str_len(out));

    if (failed > 0) { return 1; }
    return 0;
}

var rc = main();
syscall(60, rc);
