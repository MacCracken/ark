# =========================================================================
# Recipe parsing tests
# =========================================================================

fn test_recipes() {
    test_group("recipes");

    # TOML array parsing
    var ta1 = parse_toml_array(str_from("[\"a\", \"b\", \"c\"]"));
    assert_eq(vec_len(ta1), 3, "array 3 items");
    assert(str_eq(vec_get(ta1, 0), str_from("a")), "array[0]");
    assert(str_eq(vec_get(ta1, 2), str_from("c")), "array[2]");
    assert_eq(vec_len(parse_toml_array(str_from("[]"))), 0, "empty array");
    assert_eq(vec_len(parse_toml_array(0)), 0, "null array");

    # Parse inline recipe
    var ts = str_from("[package]\nname = \"test-pkg\"\nversion = \"1.0\"\n");
    var rr = recipe_parse(str_data(ts), str_len(ts));
    assert(is_ok(rr), "parse inline");
    var r = result_unwrap(rr);
    assert(str_eq(recipe_name(r), str_from("test-pkg")), "inline name");
    assert(str_eq(recipe_version(r), str_from("1.0")), "inline version");

    # Validate incomplete recipe
    var errs = recipe_validate(r);
    assert(vec_len(errs) > 0, "incomplete has errors");

    # Parse real zugot recipe if available
    var curl_path = str_from("../zugot/base/curl.cyml");
    if (file_exists(str_data(curl_path))) {
        var rr2 = recipe_parse_file(curl_path);
        assert(is_ok(rr2), "parse curl.cyml");
        var r2 = result_unwrap(rr2);
        assert(str_eq(recipe_name(r2), str_from("curl")), "curl name");
        # version is validated as parsed-non-empty rather than pinned to an
        # exact upstream value (zugot bumps curl independently of ark)
        assert(str_len(recipe_version(r2)) > 0, "curl ver parsed");
        assert(vec_len(recipe_deps_runtime(r2)) > 0, "curl runtime deps");
        assert(vec_len(recipe_deps_build(r2)) > 0, "curl build deps");
        assert(recipe_build_install(r2) > 0, "curl has install");
        var errs2 = recipe_validate(r2);
        assert_eq(vec_len(errs2), 0, "curl validates clean");
    }
}

fn test_manager() {
    test_group("ark_mgr");
    var cfg = ark_config_default();
    store64(cfg + 40, str_from("/tmp/ark-test-mkt"));
    store64(cfg + 48, str_from("/tmp/ark-test-cache"));
    var mgr = ark_mgr_new(cfg);
    var text = ark_output_to_display_string(ark_status(mgr));
    assert(str_contains(text, str_from("ark status")), "status header");
    assert(str_contains(text, str_from(ARK_VERSION_STR)), "version");
    assert(str_contains(text, str_from("ark is operational")), "operational");
}

fn test_exec() {
    test_group("exec");

    # --- lowering: system install ---
    var a1 = step_to_argv(step_system_install(str_from("nginx"), str_from("")));
    assert(a1 != 0, "system install lowered");
    assert_eq(vec_len(a1), 4, "install argv len 4");
    assert(str_eq(vec_get(a1, 0), str_from("apt-get")), "argv[0] apt-get");
    assert(str_eq(vec_get(a1, 1), str_from("install")), "argv[1] install");
    assert(str_eq(vec_get(a1, 2), str_from("-y")), "argv[2] -y");
    assert(str_eq(vec_get(a1, 3), str_from("nginx")), "argv[3] pkg");

    # --- version pin: apt pkg=ver ---
    var a2 = step_to_argv(step_system_install(str_from("nginx"), str_from("1.2.3")));
    assert(str_eq(vec_get(a2, 3), str_from("nginx=1.2.3")), "version pin pkg=ver");

    # --- remove: purge vs remove verb ---
    var a3 = step_to_argv(step_system_remove(str_from("nginx"), 0));
    assert(str_eq(vec_get(a3, 1), str_from("remove")), "remove verb");
    var a4 = step_to_argv(step_system_remove(str_from("nginx"), 1));
    assert(str_eq(vec_get(a4, 1), str_from("purge")), "purge verb");

    # --- update ---
    var a5 = step_to_argv(step_system_update());
    assert_eq(vec_len(a5), 2, "update argv len 2");
    assert(str_eq(vec_get(a5, 1), str_from("update")), "update verb");

    # --- Flutter (agpkg) lowering ---
    var af = step_to_argv(step_flutter_install(str_from("myapp"), str_from("")));
    assert(af != 0, "flutter install lowered");
    assert_eq(vec_len(af), 3, "flutter argv len 3");
    assert(str_eq(vec_get(af, 0), str_from("agpkg")), "flutter argv[0] agpkg");
    assert(str_eq(vec_get(af, 1), str_from("install")), "flutter argv[1] install");
    assert(str_eq(vec_get(af, 2), str_from("myapp")), "flutter argv[2] pkg");
    var afr = step_to_argv(step_flutter_remove(str_from("myapp")));
    assert(str_eq(vec_get(afr, 1), str_from("remove")), "flutter remove verb");
    # Flutter is unprivileged — runs directly, no shakti wrap
    assert_eq(step_needs_root(step_flutter_install(str_from("x"), str_from(""))), 0, "flutter no root");

    # --- marketplace: NOT a shell step (native .ark installer, see ADR 0002) ---
    assert_eq(step_to_argv(step_marketplace_install(str_from("x"), str_from(""))), 0, "marketplace -> native installer, not shell");

    # --- privilege classification ---
    assert_eq(step_needs_root(step_system_install(str_from("x"), str_from(""))), 1, "system needs root");
    assert_eq(step_needs_root(step_marketplace_install(str_from("x"), str_from(""))), 0, "mkt no root");

    # --- shakti wrapping ---
    var w = exec_wrap_argv(a1, 1, str_from("/usr/bin/shakti"));
    assert_eq(vec_len(w), 6, "wrapped len 6");
    assert(str_eq(vec_get(w, 0), str_from("/usr/bin/shakti")), "wrap[0] shakti");
    assert(str_eq(vec_get(w, 1), str_from("--")), "wrap[1] --");
    assert(str_eq(vec_get(w, 2), str_from("apt-get")), "wrap[2] apt-get");
    var w0 = exec_wrap_argv(a1, 0, str_from("/usr/bin/shakti"));
    assert_eq(vec_len(w0), 4, "unprivileged argv unchanged");

    # --- argv render ---
    assert(str_eq(exec_argv_to_str(a1), str_from("apt-get install -y nginx")), "argv render");

    # --- transaction op type / source classification ---
    assert_eq(step_op_type(step_system_remove(str_from("x"), 0)), OP_REMOVE, "remove op type");
    assert_eq(step_op_type(step_system_install(str_from("x"), str_from(""))), OP_INSTALL, "install op type");
    assert_eq(step_source(step_system_install(str_from("x"), str_from(""))), SOURCE_SYSTEM, "system source");

    # --- dry-run plan execution (no fork, no fs writes) ---
    var cfg = ark_config_default();
    store64(cfg + 40, str_from("/tmp/ark-test-mkt"));
    store64(cfg + 48, str_from("/tmp/ark-test-cache"));
    var mgr = ark_mgr_new(cfg);

    var plan = install_plan_new();
    vec_push(iplan_steps(plan), step_system_install(str_from("nginx"), str_from("")));
    vec_push(iplan_steps(plan), step_system_update());
    iplan_set_root(plan, 1);
    var rdry = exec_plan(mgr, plan, 1);
    assert_eq(ares_success(rdry), 1, "dry run ok");
    var dmsg = ares_message(rdry);
    assert(str_contains(dmsg, str_from("Dry run")), "dry run header");
    assert(str_contains(dmsg, str_from("/usr/bin/shakti -- apt-get install -y nginx")), "dry run wrapped cmd");
    assert(str_contains(dmsg, str_from("/usr/bin/shakti -- apt-get update")), "dry run update cmd");

    # --- empty plan ---
    var rempty = exec_plan(mgr, install_plan_new(), 1);
    assert_eq(ares_success(rempty), 1, "empty plan ok");
    assert(str_contains(ares_message(rempty), str_from("Nothing to do")), "empty plan msg");

    # --- not-wired step fails the whole plan ---
    var plan2 = install_plan_new();
    vec_push(iplan_steps(plan2), step_marketplace_install(str_from("my-agent"), str_from("1.0")));
    var rnw = exec_plan(mgr, plan2, 1);
    assert_eq(ares_success(rnw), 0, "not-wired fails plan");
    assert(str_contains(ares_message(rnw), str_from("not yet wired")), "not-wired msg");
}

fn test_ark_package() {
    test_group("ark_package");

    # --- signed fixture: full read + verify (root hash + sig + per-file) ---
    var p = ark_pkg_read("tests/fixtures/sample-signed.ark", 1048576);
    assert(p != 0, "signed fixture reads + verifies");
    var m = apkg_manifest(p);
    assert(str_eq_cstr(str_from("myapp"), apkg_man_name(m)), "manifest name");
    assert(str_eq_cstr(str_from("2.1.0"), apkg_man_version(m)), "manifest version");
    assert(str_eq_cstr(str_from("GPL-3.0-only"), apkg_man_license(m)), "manifest license");
    assert(str_eq_cstr(str_from("x86_64"), apkg_man_arch(m)), "manifest arch");
    assert_eq(apkg_man_release(m), 1, "manifest release");
    assert_eq(apkg_man_build_date(m), 1700000000, "manifest build_date");
    # description exercises TOML escape/unescape (embedded quote + newline)
    assert(str_eq_cstr(str_from("needs \"quotes\" and\na newline"),
                       apkg_man_description(m)), "description unescaped losslessly");
    # groups / depends arrays
    assert_eq(vec_len(apkg_man_groups(m)), 2, "groups count");
    assert(str_eq_cstr(str_from("base"), vec_get(apkg_man_groups(m), 0)), "groups[0]");
    assert(str_eq_cstr(str_from("net"), vec_get(apkg_man_groups(m), 1)), "groups[1]");
    assert_eq(vec_len(apkg_man_depends(m)), 1, "depends count");
    assert(str_eq_cstr(str_from("libc"), vec_get(apkg_man_depends(m), 0)), "depends[0]");

    # --- file index ---
    var fs = apkg_entries(p);
    assert_eq(vec_len(fs), 2, "file count");
    var e0 = vec_get(fs, 0);
    assert(str_eq_cstr(str_from("/etc/app.conf"), apkg_afe_path(e0)), "entry0 path");
    assert_eq(apkg_afe_file_type(e0), ARK_FT_CONFIG, "entry0 is config");
    assert_eq(apkg_afe_size(e0), 10, "entry0 size");
    assert_eq(strlen(apkg_afe_sha256(e0)), 64, "entry0 has sha256");
    var e1 = vec_get(fs, 1);
    assert(str_eq_cstr(str_from("/usr/bin/app"), apkg_afe_path(e1)), "entry1 path");
    assert_eq(apkg_afe_file_type(e1), ARK_FT_REGULAR, "entry1 is regular");

    # --- payload extraction: inflated data + offsets ---
    assert_eq(apkg_data_len(p), 28, "inflated data len (10 + 18)");
    var data = apkg_data(p);
    # entry0 payload starts at its data_offset, length = size
    var conf = str_new(data + apkg_afe_data_offset(e0), apkg_afe_size(e0));
    assert(str_eq(conf, str_from("port=8080\n")), "entry0 payload extracted");

    # --- signature present on signed package ---
    assert(strlen(apkg_sig_hex(p)) == 128, "signed: 64-byte sig as hex");

    # --- unsigned fixture: verifies, no signature ---
    var u = ark_pkg_read("tests/fixtures/sample-unsigned.ark", 1048576);
    assert(u != 0, "unsigned fixture reads + verifies");
    assert_eq(strlen(apkg_sig_hex(u)), 0, "unsigned: no signature");

    # --- tamper detection: flip a manifest byte -> root hash mismatch -> 0 ---
    var tbuf = alloc(1048576);
    var tn = file_read_all("tests/fixtures/sample-signed.ark", tbuf, 1048576);
    assert(tn > 0, "tamper: read fixture");
    store8(tbuf + 20, load8(tbuf + 20) ^ 0xFF);
    file_write_all("/tmp/ark-tamper.ark", tbuf, tn);
    assert_eq(ark_pkg_read("/tmp/ark-tamper.ark", 1048576), 0, "tampered -> 0");

    # --- truncated / garbage input is rejected, not crashed ---
    assert_eq(ark_pkg_read("/nonexistent/path.ark", 1048576), 0, "missing file -> 0");
}

fn test_ark_install() {
    test_group("ark_install");

    # Manager with temp paths so nothing touches the real system.
    var cfg = ark_config_default();
    store64(cfg + 40, str_from("/tmp/ark-inst-mkt"));     # marketplace_dir
    store64(cfg + 48, str_from("/tmp/ark-inst-cache"));   # cache_dir
    store64(cfg + 56, str_from("/tmp/ark-inst-db.json")); # package_db_path
    store64(cfg + 64, str_from("/tmp/ark-inst-txn.log")); # transaction_log_path
    var mgr = ark_mgr_new(cfg);

    var res = ark_pkg_install(mgr, "tests/fixtures/sample-signed.ark",
                              "/tmp/ark-inst-root", 1048576);
    assert_eq(ares_success(res), 1, "install succeeds");
    assert(str_contains(ares_message(res), str_from("Installed myapp 2.1.0")), "install message");

    # Files materialized under the install root, parents created.
    assert(file_exists("/tmp/ark-inst-root/etc/app.conf"), "config file on disk");
    assert(file_exists("/tmp/ark-inst-root/usr/bin/app"), "binary file on disk");

    # Payload content is the verified bytes.
    var rb = alloc(256);
    var rn = file_read_all("/tmp/ark-inst-root/etc/app.conf", rb, 256);
    assert(str_eq(str_new(rb, rn), str_from("port=8080\n")), "config content correct");

    # Registered in PackageDb with version, files, per-file hash, signature.
    var db = amgr_db(mgr);
    assert(pkg_db_is_installed(db, str_from("myapp")), "registered in db");
    var entry = pkg_db_get(db, "myapp");
    assert(entry != 0, "entry retrievable");
    assert(str_eq(pdbe_version(entry), str_from("2.1.0")), "db entry version");
    assert_eq(vec_len(pdbe_files(entry)), 2, "db entry tracks 2 files");
    var h = pdbe_get_file_hash(entry, str_from("/etc/app.conf"));
    assert(h != 0, "per-file hash recorded");
    assert_eq(str_len(h), 64, "per-file hash is sha256 hex");
    assert(str_len(pdbe_signature(entry)) == 128, "signed package records signature");

    # Reading a missing/garbage package fails cleanly (no install).
    var bad = ark_pkg_install(mgr, "/nonexistent.ark", "/tmp/ark-inst-root", 1048576);
    assert_eq(ares_success(bad), 0, "missing package -> failure");
}

fn test_ark_install_cli() {
    test_group("ark_install_cli");

    # `.ark` path detection (only a real .ark suffix routes to local install)
    assert(apkg_is_ark_path(str_from("/x/foo.ark")) == 1, ".ark path detected");
    assert(apkg_is_ark_path(str_from("nginx")) == 0, "plain name is not a .ark path");
    assert(apkg_is_ark_path(str_from("foo.ark.txt")) == 0, "non-suffix is not a .ark path");

    # ark_execute routes a single `.ark` install arg to the local installer
    var cfg = ark_config_default();
    store64(cfg + 40, str_from("/tmp/ark-cli-mkt"));
    store64(cfg + 48, str_from("/tmp/ark-cli-cache"));
    store64(cfg + 56, str_from("/tmp/ark-cli-db.json"));
    store64(cfg + 64, str_from("/tmp/ark-cli-txn.log"));
    var mgr = ark_mgr_new(cfg);

    var cmd = ark_cmd_new(CMD_INSTALL);
    vec_push(acmd_packages(cmd), str_from("tests/fixtures/sample-unsigned.ark"));
    acmd_set_root(cmd, str_from("/tmp/ark-cli-root"));
    var res = ark_execute(mgr, cmd);
    assert_eq(ares_success(res), 1, "cli local install succeeds");
    assert(file_exists("/tmp/ark-cli-root/usr/bin/app"), "cli install materialized file");
    assert(pkg_db_is_installed(amgr_db(mgr), str_from("myapp")), "cli install registered in db");
}

fn test_marketplace() {
    test_group("marketplace");

    # cache-path uses mela's sanitize_filename: <cache>/<name>-<version>.ark
    var cp = ark_marketplace_cache_path(str_from("/tmp/ark-mkt-cache"),
                                        str_from("myapp"), str_from("2.1.0"));
    assert(str_contains(cp, str_from("myapp-2_1_0.ark")), "cache path built (sanitized)");

    # Marketplace forces require_signed, so provision a trust set with the
    # fixture's signer key.
    var fp = ark_pkg_read("tests/fixtures/sample-signed.ark", 1048576);
    file_write_all("/tmp/ark-mkt-trust", apkg_pubkey(fp), strlen(apkg_pubkey(fp)));

    var cfg = ark_config_default();
    store64(cfg + 40, str_from("/tmp/ark-mkt-mkt"));
    store64(cfg + 48, str_from("/tmp/ark-mkt-cache"));
    store64(cfg + 56, str_from("/tmp/ark-mkt-db.json"));
    store64(cfg + 64, str_from("/tmp/ark-mkt-txn.log"));
    acfg_set_trust_keys(cfg, str_from("/tmp/ark-mkt-trust"));
    var mgr = ark_mgr_new(cfg);

    # Cache hit: pre-stage the fixture at the computed cache path so install
    # runs fully offline (no network) through the mela download path.
    apkg_mkdir_p(str_data(str_from("/tmp/ark-mkt-cache")));
    var dst = str_data(ark_marketplace_cache_path(str_from("/tmp/ark-mkt-cache"),
                                                  str_from("myapp"), str_from("2.1.0")));
    var fb = alloc(4096);
    var fn2 = file_read_all("tests/fixtures/sample-signed.ark", fb, 4096);
    file_write_all(dst, fb, fn2);
    var res = ark_marketplace_install(mgr, str_from("https://example.invalid/"),
                                      str_from("/tmp/ark-mkt-cache"),
                                      str_from("myapp"), str_from("2.1.0"),
                                      str_from("/tmp/ark-mkt-root"), 1048576);
    assert_eq(ares_success(res), 1, "cache-hit marketplace install (trusted signer) succeeds");
    assert(file_exists("/tmp/ark-mkt-root/usr/bin/app"), "marketplace install materialized file");
    assert(pkg_db_is_installed(amgr_db(mgr), str_from("myapp")), "registered in db");

    # Untrusted signer: marketplace forces require_signed -> refused (fail closed).
    var cfgu = ark_config_default();
    store64(cfgu + 48, str_from("/tmp/ark-mkt-cache"));
    store64(cfgu + 56, str_from("/tmp/ark-mkt-dbu.json"));
    store64(cfgu + 64, str_from("/tmp/ark-mkt-txnu.log"));
    acfg_set_trust_keys(cfgu, str_from("/tmp/ark-mkt-trust-absent"));
    var mgru = ark_mgr_new(cfgu);
    var rej = ark_marketplace_install(mgru, str_from("https://example.invalid/"),
                                      str_from("/tmp/ark-mkt-cache"),
                                      str_from("myapp"), str_from("2.1.0"),
                                      str_from("/tmp/ark-mkt-rootu"), 1048576);
    assert_eq(ares_success(rej), 0, "marketplace install w/ untrusted signer refused");

    # Invalid version segment is rejected by mela's validator.
    var bad = ark_marketplace_install(mgr, str_from("https://example.invalid/"),
                                      str_from("/tmp/ark-mkt-cache"),
                                      str_from("myapp"), str_from("../etc/passwd"),
                                      str_from("/tmp/ark-mkt-root"), 1048576);
    assert_eq(ares_success(bad), 0, "invalid version rejected");

    # name@version arg parsing requires the '@'.
    var noat = ark_marketplace_install_arg(mgr, str_from("https://example.invalid/"),
                                           str_from("myapp"), str_from(""));
    assert_eq(ares_success(noat), 0, "missing @version rejected");
}

fn test_nous_integration() {
    test_group("nous_integration");
    # Integration against the REAL nous resolver, using the zugot recipe corpus
    # as real data. Gated on the corpus being present (mirrors test_recipes).
    if (file_exists("../zugot/base/curl.cyml") == 0) { return 0; }

    sys_mkdir("/tmp/ark-int-mkt", 493);
    var rr = resolver_new(str_from("/tmp/ark-int-mkt"), str_from("/tmp/ark-int-cache"));
    assert(is_ok(rr) == 1, "resolver_new ok");
    var r = payload(rr);
    var rdb = recipe_db_load(str_from("../zugot"));
    assert(rdb != 0, "zugot recipe DB loaded");
    resolver_with_recipes(r, rdb);

    # Transitive resolve through the recipe-aware path (resolver_resolve alone
    # has no recipe fallback — only resolve_all_with_recipes does).
    var names = vec_new();
    vec_push(names, str_from("curl"));
    var ra = resolver_resolve_all_with_recipes(r, names);
    assert(is_err_result(ra) == 0, "resolve_all(curl) returns ok");
    var pkgs = pl_packages(payload(ra));
    assert(vec_len(pkgs) >= 1, "plan resolved >= 1 package");
    var found = 0;
    var i = 0;
    while (i < vec_len(pkgs)) {
        var pk = vec_get(pkgs, i);
        if (str_eq(rp_name(pk), str_from("curl")) == 1) {
            found = 1;
            assert(str_len(rp_ver(pk)) > 0, "curl resolved with a version");
        }
        i = i + 1;
    }
    assert(found == 1, "curl present in the resolved plan (via recipe DB)");

    # Search returns cleanly (no apt + empty marketplace here — just no crash).
    var sr = resolver_search(r, str_from("curl"));
    assert(is_err_result(sr) == 0, "search returns a clean Result");

    # Unknown package: clean miss, no crash (the 1.2.7 SIGSEGV regression).
    var bog = resolver_resolve(r, str_from("zzznonexistentpkg"));
    assert(is_err_result(bog) == 0, "unknown pkg resolves without error");
    assert_eq(payload(bog), 0, "unknown pkg -> none");
}

fn test_pkg_security() {
    test_group("pkg_security");
    # Zip-slip / path-traversal guard (CWE-22) on .ark entry paths.
    # apkg_path_safe takes a cstr (the entry path is stored NUL-terminated).
    assert_eq(apkg_path_safe("/usr/bin/app"), 1, "normal path safe");
    assert_eq(apkg_path_safe("/etc/nginx/nginx.conf"), 1, "nested path safe");
    assert_eq(apkg_path_safe("/lib..so"), 1, "dots-in-name not a traversal");
    assert_eq(apkg_path_safe("/../../etc/passwd"), 0, "leading traversal rejected");
    assert_eq(apkg_path_safe("/usr/../../etc/x"), 0, "mid traversal rejected");
    assert_eq(apkg_path_safe("/etc/.."), 0, "trailing traversal rejected");
    assert_eq(apkg_path_safe("relative/path"), 0, "non-absolute rejected");
    assert_eq(apkg_path_safe(""), 0, "empty rejected");

    # --- trust anchor (audit finding #4) ---
    var p = ark_pkg_read("tests/fixtures/sample-signed.ark", 1048576);
    assert(p != 0, "signed fixture reads");
    var pkhex = apkg_pubkey(p);
    assert_eq(strlen(pkhex), 64, "signed package exposes 32-byte pubkey hex");
    var up = ark_pkg_read("tests/fixtures/sample-unsigned.ark", 1048576);
    assert_eq(strlen(apkg_pubkey(up)), 0, "unsigned package has no pubkey");

    # Trust set: only a package whose signer key is listed is trusted.
    file_write_all("/tmp/ark-trust-keys", pkhex, strlen(pkhex));
    var store = ark_trust_load("/tmp/ark-trust-keys");
    assert_eq(ark_pkg_signer_trusted(p, store), 1, "signer in trust set -> trusted");
    var empty = ark_trust_load("/tmp/ark-trust-absent-xyz");
    assert_eq(ark_pkg_signer_trusted(p, empty), 0, "empty trust set -> untrusted");
    assert_eq(ark_pkg_signer_trusted(up, store), 0, "unsigned -> never trusted");

    # Install gate: require_signed enforces the trust set (fail closed).
    var cfg = ark_config_default();
    store64(cfg + 48, str_from("/tmp/ark-ts-cache"));
    store64(cfg + 56, str_from("/tmp/ark-ts-db.json"));
    store64(cfg + 64, str_from("/tmp/ark-ts-txn.log"));
    acfg_set_require_signed(cfg, 1);
    acfg_set_trust_keys(cfg, str_from("/tmp/ark-trust-keys"));
    var mgr = ark_mgr_new(cfg);
    var okr = ark_pkg_install(mgr, "tests/fixtures/sample-signed.ark", "/tmp/ark-ts-root", 1048576);
    assert_eq(ares_success(okr), 1, "require_signed + trusted signer -> install ok");

    var cfg2 = ark_config_default();
    store64(cfg2 + 48, str_from("/tmp/ark-ts-cache"));
    store64(cfg2 + 56, str_from("/tmp/ark-ts-db2.json"));
    store64(cfg2 + 64, str_from("/tmp/ark-ts-txn2.log"));
    acfg_set_require_signed(cfg2, 1);
    acfg_set_trust_keys(cfg2, str_from("/tmp/ark-trust-absent-xyz"));
    var mgr2 = ark_mgr_new(cfg2);
    var rej = ark_pkg_install(mgr2, "tests/fixtures/sample-signed.ark", "/tmp/ark-ts-root2", 1048576);
    assert_eq(ares_success(rej), 0, "require_signed + untrusted signer -> refused");
    assert(str_contains(ares_message(rej), str_from("not trusted")), "refusal message");

    # --- trust set sourced from a mela publisher keyring ---
    var kr = mela_keyring_new();
    mela_keyring_add_key(kr, kv_new(str_from("pub-myapp"), 0, 0, 0, str_from(pkhex)));
    var ks = ark_trust_from_keyring(kr);
    assert_eq(ark_pkg_signer_trusted(p, ks), 1, "keyring-sourced trust accepts the signer");
    var emptykr = mela_keyring_new();
    assert_eq(ark_pkg_signer_trusted(p, ark_trust_from_keyring(emptykr)), 0, "empty keyring -> untrusted");
}

