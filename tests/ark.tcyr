fn test_main() {
    alloc_init();
    test_parse_args();
    test_ark_config();
    test_package_db();
    test_transaction_log();
    test_ark_output();
    test_install_plan();
    test_sources_and_groups();
    test_security();
    test_recipes();
    test_manager();
    test_exec();
    test_ark_package();
    test_ark_install();
    test_ark_install_cli();
    test_marketplace();
    test_nous_integration();
    test_pkg_security();
    return assert_summary();
}

var exit_code = test_main();
syscall(60, exit_code);
